// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A<T> {
  fn foo(self: &Self, t: T) {}
}

struct S<T> {}

extension<T> S<T> : A<T> {}

fn foo<T : A<T>>(t: T) {
  let x: *any A<T> = gc t;
  // CHECK: DeclStmt
  // CHECK-NEXT:   VarDecl @({{.*}}) x {*any A<T>}
  // CHECK-NEXT:     TraitObjectPromoExpr {*any A<T>}
  // CHECK-NEXT:       GCExpr {*T}
}

fn main() {}
