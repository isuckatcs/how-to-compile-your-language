// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A {}

struct S<T, U> {}

extension<T> S<T, number> : A {}

extension<T> S<T, bool> : A {}

extension<T, U> S<T, U> : A {}
// CHECK: [[# @LINE - 1 ]]:25: error: extension 'S<T, U> : A' conflicts with extension 'S<T, number> : A' for type 'S<_, number>'

fn main() {}
// CHECK-NOT: {{.*error.*}}
