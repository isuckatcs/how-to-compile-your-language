// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n456\n'
trait A {
  fn foo();
}

struct S {}

extension S {
  fn foo<T>() {
    println(123);
  }
}

extension S : A {
  fn foo() {
    println(456);
  }
  // CHECK: define void @_YT1AGS1SE3foo(ptr %closure) {
  // CHECK-NEXT: entry:
  // CHECK-NEXT:   call void @_Y7println(double 4.560000e+02, ptr null)
  // CHECK-NEXT:   ret void
  // CHECK-NEXT: }
}

fn main() {
  S::foo@<S>();
  @<S : A>::foo();
}
// CHECK: define void @_Y4main(ptr %closure) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   call void @_YS1S3fooGS1SE(ptr null)
// CHECK-NEXT:   call void @_YT1AGS1SE3foo(ptr null)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }

// CHECK: define void @_YS1S3fooGS1SE(ptr %closure) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   call void @_Y7println(double 1.230000e+02, ptr null)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }
