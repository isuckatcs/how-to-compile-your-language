// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n'

// CHECK: @vtable.S.A = internal constant [1 x ptr] [ptr @_YT1A3fooGS1SE]

trait A {
  fn foo(self: borrowed Self) {}
}

struct S {
  impl A;
}

fn main() {
  let s: *impl A = gc(S {});
  let s2: *impl A = gc(S {});
  let s3: *impl A = gc(S {});
  let s4: *impl A = gc(S {});
  let s5: *impl A = gc(S {});

  println(123);
}
// CHECK-NOT: {{^@vtable.*}}
