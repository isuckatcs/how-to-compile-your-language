// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A<T> {}

trait B {
  fn foo(self: &Self) {}
}

extension<T : A<number>> T : B {}

extension number : A<number> {}

// CHECK: [[# @LINE + 1 ]]:18: error: extension 'number : B' conflicts with extension 'T : B'
extension number : B {}

fn foo<T : B>(t: T) {}

fn main() {
  123.foo();

  foo(123);
}
