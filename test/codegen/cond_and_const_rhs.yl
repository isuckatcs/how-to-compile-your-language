// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '1\n'
fn foo(): number {
  mut cond1 = true;
  let cond2 = true;

  if cond1 && cond2 {
  // CHECK: %2 = phi i1 [ true, %and.rhs ], [ false, %entry ]
    return 1;
  }

  return 0;
}

fn main() {
  println(foo());
}
