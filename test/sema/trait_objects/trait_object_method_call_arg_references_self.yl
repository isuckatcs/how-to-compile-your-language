// RUN: compiler %s 2>&1 -res-dump | filecheck %s
struct T<T> {}

trait Foo {
  // CHECK: [[# @LINE + 1 ]]:33: error: trait 'Foo' with a method referecing 'Self' in a non-receiver parameter type cannot be used as a trait object
  fn value(self: borrowed Self, x: Self) {}
  
  // CHECK: [[# @LINE + 1 ]]:31: error: trait 'Foo' with a method referecing 'Self' in a non-receiver parameter type cannot be used as a trait object
  fn out(self: borrowed Self, x: borrowed Self) {}
  
  // CHECK: [[# @LINE + 1 ]]:31: error: trait 'Foo' with a method referecing 'Self' in a non-receiver parameter type cannot be used as a trait object
  fn ptr(self: borrowed Self, x: *Self) {}
  
  // CHECK: [[# @LINE + 1 ]]:34: error: trait 'Foo' with a method referecing 'Self' in a non-receiver parameter type cannot be used as a trait object
  fn mutPtr(self: borrowed Self, x: *mut Self) {}

  // CHECK: [[# @LINE + 1 ]]:36: error: trait 'Foo' with a method referecing 'Self' in a non-receiver parameter type cannot be used as a trait object
  fn template(self: borrowed Self, x: T<Self>) {}
}

struct S {
  impl Foo;
}

fn main() {
  // CHECK: [[# @LINE + 1 ]]:19: error: trait 'Foo' is not trait object compatible
  mut x: *mut any Foo = gcMut(S{});
}
