// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait Foo {
  // CHECK: [[# @LINE + 1 ]]:23: error: trait 'Foo' with a method referecing 'Self' in a non-receiver parameter type cannot be used as a trait object
  fn arg(self: &Self, x: Self) {}

  // CHECK: [[# @LINE + 1 ]]:6: error: trait 'Foo' with a method returning a type referencing 'Self' cannot be used as a trait object
  fn ret(self: &Self): Self {}

  // CHECK: [[# @LINE + 1 ]]:6: error: trait 'Foo' with a static method cannot be used as a trait object
  fn static() {}

  // CHECK: [[# @LINE + 1 ]]:6: error: trait 'Foo' with a template method cannot be used as a trait object
  fn generic<T>(self: &Self) {}

  // CHECK: [[# @LINE + 1 ]]:6: error: trait 'Foo' with a template method cannot be used as a trait object
  fn staticGeneric<T>(self: &Self) {}
}

// CHECK: [[# @LINE + 1 ]]:16: error: trait 'Foo' is not trait object compatible
fn foo(x: *any Foo) {}

fn main() {}
