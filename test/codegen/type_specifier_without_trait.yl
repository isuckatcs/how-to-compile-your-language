// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzxe '123\n'
trait A {
  fn foo() {
    println(123);
  }
}

extension number : A {}

fn main() {
  @<number>::foo();
  // CHECK: call void @_YT1AGnE3foo(ptr null)
}

// CHECK: define void @_YT1AGnE3foo(ptr %closure) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   call void @_Y7println(double 1.230000e+02, ptr null)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }
