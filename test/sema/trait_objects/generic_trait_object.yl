// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait Foo<T> {
  fn foo(self: &Self, x: T) {}
}

fn foo(x: *mut any Foo<number>) {
  x.foo(123);
}
// CHECK: FunctionDecl @({{.*}}) foo {(*mut any Foo<number>) -> unit}
// CHECK-NEXT:   ParamDecl @({{.*}}) x {*mut any Foo<number>}
// CHECK-NEXT:   Block
// CHECK-NEXT:     CallExpr {unit}
// CHECK-NEXT:       DeclRefExpr @({{.*}}) foo {(&any Foo<number>, number) -> unit}
// CHECK-NEXT:       ImplicitPtrToRefDecay {&any Foo<number>}
// CHECK-NEXT:         DeclRefExpr @({{.*}}) x {*mut any Foo<number>}
// CHECK-NEXT:       NumberLiteral '123' {number}
// CHECK-NEXT:       | value: 123

fn main() {}
