// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '0\n1\n2\n3\n0\n1\n2\n3\n'
trait A {
  fn a(self: borrowed Self) { println(0); }
}

trait B1 : A {
  fn b(self: borrowed Self) { println(1); }
}

trait B2 : A {
  fn b(self: borrowed Self) { println(2); }
}

trait C : B1 & B2 {
  fn c(self: borrowed Self) { println(3); }
}

struct S {
  impl A;
  impl B1;
  impl B2;
  impl C;
}

fn generateVtable(c: *impl C) {
  c.a();
  @<impl C : B1>::b(c);
  @<impl C : B2>::b(c);
  c.c();
}

fn main() {
  let s = gc(S {});

  generateVtable(s);

  // CHECK: @vtable.S.C = internal constant [5 x ptr] [ptr @_YT1A1aGS1SE, ptr @_YT2B11bGS1SE, ptr @_YT1A1aGS1SE, ptr @_YT2B21bGS1SE, ptr @_YT1C1cGS1SE]

  s.a();
  // CHECK: call void @_YT1A1aGS1SE(ptr %4, ptr null)

  @<S : B1>::b(s);
  // CHECK: call void @_YT2B11bGS1SE(ptr %5, ptr null)
  
  @<S : B2>::b(s);
  // CHECK: call void @_YT2B21bGS1SE(ptr %6, ptr null)
  
  s.c();
  // CHECK: call void @_YT1C1cGS1SE(ptr %7, ptr null)
}
