// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n'

// CHECK: @vtable.T1AGS1SE = internal constant [1 x ptr] [ptr @_YT1AGS1SE3foo]

trait A {
  fn foo(self: &Self) {}
}

struct S {}

extension S : A {}

fn main() {
  let s: *any A = gc S {};
  let s2: *any A = gc S {};
  let s3: *any A = gc S {};
  let s4: *any A = gc S {};
  let s5: *any A = gc S {};

  println(123);
}
// CHECK-NOT: {{^@vtable.*}}
