// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A<T> {}

extension number : A<number> {}
extension number : A<bool> {}

fn foo<T>(a: &any A<T>) {}

fn main() {
  let n = 123;
  foo(n);
  // CHECK: [[# @LINE - 1 ]]:7: error: 'A<number>' ambiguously satisfies requirement 'number : A<_>'
  // CHECK: [[# @LINE - 2 ]]:7: error: 'A<bool>' ambiguously satisfies requirement 'number : A<_>'
  // CHECK: [[# @LINE - 3 ]]:7: error: explicit type annotations needed to disambiguate requirements
  // CHECK: [[# @LINE - 4 ]]:7: error: cannot unify 'number' with '&any A<_>'
}
