// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A<T, U> {}

struct S<T, U> {}

extension<T, U> S<T, U> : A<T, number> {}

// CHECK: [[# @LINE + 1 ]]:27: error: implementing trait 'A<number, U>' conflicts with implementation 'A<T, number>'
extension<T, U> S<T, U> : A<number, U> {}

trait B<T> {}

struct S2<T> {}

extension<T> S2<T> : B<T> {}

// CHECK: [[# @LINE + 1 ]]:22: error: implementing trait 'B<number>' conflicts with implementation 'B<T>'
extension<T> S2<T> : B<number> {}

struct S3<T> {}

extension<T> S3<T> : B<number> {}

// CHECK: [[# @LINE + 1 ]]:22: error: implementing trait 'B<T>' conflicts with implementation 'B<number>'
extension<T> S3<T> : B<T> {}

fn main() {}
