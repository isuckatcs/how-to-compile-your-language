// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A<T : Base<S>> {}
// CHECK: TraitDecl @({{.*}}) A
// CHECK-NEXT:   TypeParamDecl @({{.*}}) Self {Self}
// CHECK-NEXT:     TraitConformance Self : A<T>
// CHECK-NEXT:   TypeParamDecl @({{.*}}) T {T}
// CHECK-NEXT:     TraitConformance T : Base<S>

trait B {}
// CHECK-NEXT: TraitDecl @({{.*}}) B
// CHECK-NEXT:   TypeParamDecl @({{.*}}) Self {Self}
// CHECK-NEXT:     TraitConformance Self : B

trait Base<T : B> {}
// CHECK-NEXT: TraitDecl @({{.*}}) Base
// CHECK-NEXT:   TypeParamDecl @({{.*}}) Self {Self}
// CHECK-NEXT:     TraitConformance Self : Base<T>
// CHECK-NEXT:   TypeParamDecl @({{.*}}) T {T}
// CHECK-NEXT:     TraitConformance T : B

struct S {}

extension S : B {}
// CHECK: StructDecl @({{.*}}) S {S}

fn main() {}
