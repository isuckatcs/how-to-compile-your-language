// RUN: compiler %s 2>&1 -res-dump | filecheck %s
struct S {}

extension S {
  fn method(self: &Self): Self {
    return self;
  }
}

fn main() {
  let s = S{};

  // CHECK: [[# @LINE + 1 ]]:5: error: failed to find field 'method' in 'S'
  s.method;

  // CHECK: [[# @LINE + 1 ]]:5: error: failed to find field 'method' in 'S'
  s.method.method;

  // CHECK: [[# @LINE + 1 ]]:14: error: failed to find field 'method' in 'S'
  s.method().method;
  
  // CHECK: [[# @LINE + 1 ]]:5: error: failed to find field 'method' in 'S'
  s.method.method();
}
