// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n456\n123\n456\n'

// CHECK: @vtable.T1AGS1SnE = internal constant [2 x ptr] [ptr @_YT1BGS1SnE3bar, ptr @_YT1AGS1SnE3foo]

trait A<T> : B<T> {
  fn foo(self: &Self, t: T) {
    println(123);
  }
}

trait B<T> {
  fn bar(self: &Self, t: T) {
    println(456);
  }
}

struct S {}

extension S : A<number> {}

extension S : B<number> {}

fn main() {
  let s = gc(S {});

  s.foo(0);
  // CHECK: call void @_YT1AGS1SnE3foo(ptr %1, double 0.000000e+00, ptr null)

  s.bar(0);
  // CHECK: call void @_YT1BGS1SnE3bar(ptr %2, double 0.000000e+00, ptr null)

  mut p: *any A<number> = s;

  p.foo(0);
  // CHECK: %vFnPtr = getelementptr ptr, ptr %vtable, i32 1

  p.bar(0);
  // CHECK: %vFnPtr6 = getelementptr ptr, ptr %vtable5, i32 0
}
