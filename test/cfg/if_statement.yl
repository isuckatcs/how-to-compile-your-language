fn nestedInLoopConditionalOps(): unit {
    if true || true {
        while true {}
    } else if true && true {
        while true {}
    } else {
        while true {}
    }
}
// CHECK: fn nestedInLoopConditionalOps(...) {
// CHECK-NEXT: bb9:
// CHECK-NEXT:   preds: 
