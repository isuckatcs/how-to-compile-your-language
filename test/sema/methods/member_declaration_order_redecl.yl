// RUN: compiler %s 2>&1 -res-dump | filecheck %s
struct S {
  x: number,
  y: number,
  z: number,
  foo: number,
}

extension S {
  // CHECK: [[# @LINE + 1 ]]:6: error: redeclaration of 'x'
  fn x() {}
}

extension S {
  // CHECK: [[# @LINE + 1 ]]:6: error: redeclaration of 'foo'
  fn foo() {}
}

fn main() {}
