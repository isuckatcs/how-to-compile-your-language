// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A<T> {}

struct S<T : A<T>> {
  fn foo(x: T) {}
}

struct S2<X> {
  x: X
}

extension<X> S2<X> : A<X> {}

fn main() {
  let s2 = S2{ x: 0 };
  S::foo(s2);
  // CHECK: [[# @LINE - 1 ]]:10: error: cannot satisfy requirement 'S2<number> : A<S2<number>>'
}
