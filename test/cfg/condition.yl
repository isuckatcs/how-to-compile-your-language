// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
fn main(): unit {
    true || false;
    1.0;
}
// CHECK: fn main(...) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   $1 = true
// CHECK-NEXT:   $2 = false
// CHECK-NEXT:   $3 = $1 || $2
// CHECK-NEXT:   $4 = 1
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }

