// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n'
trait A {
  fn foo(self: &Self);
}

extension number : A {
  fn foo(self: &Self) {
    println(self);
  }
}

fn foo(a: &any A) {
  a.foo();
}

fn bar(n: &number) {
  foo(n);
  // CHECK: %0 = getelementptr inbounds nuw { ptr, ptr }, ptr %traitObject, i32 0, i32 0
  // CHECK-NEXT: store ptr %n, ptr %0, align 8
  // CHECK-NEXT: %1 = getelementptr inbounds nuw { ptr, ptr }, ptr %traitObject, i32 0, i32 1
  // CHECK-NEXT: store ptr @vtable.T1AGnE, ptr %1, align 8
}

fn main() {
  let n = 123;
  bar(n);
}
