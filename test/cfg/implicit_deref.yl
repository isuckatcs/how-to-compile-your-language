// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
fn foo(n: &number) {
  let x = n;
}
// CHECK: fn foo({{.*}}) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   $1 = n
// CHECK-NEXT:   $2 = (implicit deref) $1
// CHECK-NEXT:   let x = $2
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }

fn main() {}
