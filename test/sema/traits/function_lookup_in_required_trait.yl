// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait C {}

trait B : C {
  fn foo(self: borrowed Self) {}
  // CHECK: FunctionDecl @({{.*}}) foo {(borrowed Self) -> unit}
  // CHECK-NEXT:   ParamDecl @({{.*}}) self {borrowed Self}
  // CHECK-NEXT:   Block
}

trait A : B {}

fn foo<T : C>(t : T) {}

fn bar<T : A>(t : T) {
  t.foo();
  // CHECK: CallExpr {unit}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) foo {(borrowed T) -> unit}
  // CHECK-NEXT:   ImplicitBorrowExpr {borrowed T}
  // CHECK-NEXT:     DeclRefExpr @({{.*}}) t {T}

  T::foo(t);
  // CHECK: CallExpr {unit}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) foo {(borrowed T) -> unit}
  // CHECK-NEXT:   ImplicitBorrowExpr {borrowed T}
  // CHECK-NEXT:     DeclRefExpr @({{.*}}) t {T}
}

fn main() {}
