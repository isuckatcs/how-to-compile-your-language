// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A<T> {
  fn foo(self: &Self, x: T) {}
}

struct S {}

extension S : A<number> {
  fn foo(self: &Self, x: number) {}
}

extension S : A<unit> {
  fn foo(self: &Self, x: unit) {}
}

fn main() {
  let s = S{};

  // CHECK: [[# @LINE + 1]]:28: error: cannot unify 'unit' with 'number'
  @<S : A<number>>::foo(s, unit);
}
