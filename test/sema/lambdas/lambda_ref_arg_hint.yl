// RUN: compiler %s -res-dump 2>&1 | filecheck %s
fn main() {
  let f: (&number) -> unit = ->(x) { println(x); };
  // CHECK: LambdaExpr {(&number) -> unit}
  // CHECK-NEXT:   StructDecl @({{.*}}) (closure@{{.*}}) {(closure@{{.*}})}
  // CHECK-NEXT:     FunctionDecl @({{.*}}) __builtin_lambda_call {(&number, *(closure@{{.*}})) -> unit}
  // CHECK-NEXT:       ParamDecl @({{.*}}) x {&number}
  // CHECK-NEXT:       ParamDecl @({{.*}}) closure {*(closure@{{.*}})}
  // CHECK-NEXT:       Block
  // CHECK-NEXT:         CallExpr {unit}
  // CHECK-NEXT:           DeclRefExpr @({{.*}}) println {(number) -> unit}
  // CHECK-NEXT:           ImplicitDerefExpr {number}
  // CHECK-NEXT:             DeclRefExpr @({{.*}}) x {&number}

  let f2: (&mut number) -> unit = ->(x) { println(x); };
  // CHECK: LambdaExpr {(&mut number) -> unit}
  // CHECK-NEXT:   StructDecl @({{.*}}) (closure@{{.*}}) {(closure@{{.*}})}
  // CHECK-NEXT:     FunctionDecl @({{.*}}) __builtin_lambda_call {(&mut number, *(closure@{{.*}})) -> unit}
  // CHECK-NEXT:       ParamDecl @({{.*}}) x {&mut number}
  // CHECK-NEXT:       ParamDecl @({{.*}}) closure {*(closure@{{.*}})}
  // CHECK-NEXT:       Block
  // CHECK-NEXT:         CallExpr {unit}
  // CHECK-NEXT:           DeclRefExpr @({{.*}}) println {(number) -> unit}
  // CHECK-NEXT:           ImplicitDerefExpr {number}
  // CHECK-NEXT:             DeclRefExpr @({{.*}}) x {&mut number}
}
