// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A {
  fn foo() {}
}

struct S {}

extension S : A {
  fn foo() {}

  // CHECK: [[# @LINE + 1 ]]:6: error: redeclaration of 'foo'
  fn foo() {}
}

// CHECK: [[# @LINE + 1 ]]:13: error: extension 'S : A' conflicts with extension 'S : A'
extension S : A {
  fn foo() {}
}

fn main() {}
