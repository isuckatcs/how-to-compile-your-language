// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n456\n'
fn foo<T>(b: bool): (T) -> T {
  let l: (T) -> T;
  let x = 0;

  if b {
    l = ->(n) {
      x;
      println(123);
      return n; 
    };
  } else {
    l = ->(n) {
      x;
      println(456);
      return n; 
    };
  }

  return l;
}

fn main() {
  foo(true)(unit);
  // CHECK: store ptr @_Y3fooGuES8lambda_021__builtin_lambda_call, ptr %1, align 8
  // CHECK: store ptr @_Y3fooGuES8lambda_121__builtin_lambda_call, ptr %5, align 8

  foo(false)(0);
  // CHECK: store ptr @_Y3fooGnES8lambda_021__builtin_lambda_call, ptr %1, align 8
  // CHECK: store ptr @_Y3fooGnES8lambda_121__builtin_lambda_call, ptr %5, align 8
}
