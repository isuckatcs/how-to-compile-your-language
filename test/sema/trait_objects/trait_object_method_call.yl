// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {
  fn foo(self: borrowed Self, x: number) {}
}

struct S {}

extension S : A {}

fn foo(x: *mut any A) {
  x.foo(123);
}
// CHECK: FunctionDecl @({{.*}}) foo {(*mut any A) -> unit}
// CHECK-NEXT:   ParamDecl @({{.*}}) x {*mut any A}
// CHECK-NEXT:   Block
// CHECK-NEXT:     CallExpr {unit}
// CHECK-NEXT:       DeclRefExpr @({{.*}}) foo {(borrowed any A, number) -> unit}
// CHECK-NEXT:       ImplicitPtrToBorrowDecay {borrowed any A}
// CHECK-NEXT:         DeclRefExpr @({{.*}}) x {*mut any A}
// CHECK-NEXT:       NumberLiteral '123' {number}
// CHECK-NEXT:       | value: 123

fn main() {}
