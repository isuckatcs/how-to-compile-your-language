// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
struct S {
  x: number,
  y: number
}

fn main(): unit {
  mut s = S { y: 2, x: 1 };

  s.x = 0;
}
// CHECK: fn main({{.*}}) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   $1 = 2
// CHECK-NEXT:   $2 = 1
// CHECK-NEXT:   $3 = S { y: $1, x: $2 }
// CHECK-NEXT:   mut s = $3
// CHECK-NEXT:   $4 = 0
// CHECK-NEXT:   $5 = s
// CHECK-NEXT:   $5.x = $4
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }
