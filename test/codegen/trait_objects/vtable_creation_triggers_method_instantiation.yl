// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '3\n'
trait A {
  fn a(self: &Self) { println(0); }
}

trait B1 : A {
  fn b(self: &Self) { println(1); }
}

trait B2 : A {
  fn b(self: &Self) { println(2); }
}

trait C : B1 & B2 {
  fn c(self: &Self) { println(3); }
}

struct S {}

extension S : A {}

extension S : B1 {}

extension S : B2 {}

extension S : C {}

fn main() {
  let s: *any C = gc(S {});
  s.c();
}

// CHECK: @vtable.T1CGS1SE = internal constant [4 x ptr] [ptr @_YT1AGS1SE1a, ptr @_YT2B1GS1SE1b, ptr @_YT2B2GS1SE1b, ptr @_YT1CGS1SE1c]
// CHECK: define void @_YT1AGS1SE1a(ptr %self, ptr %closure)
// CHECK: define void @_YT2B1GS1SE1b(ptr %self, ptr %closure)
// CHECK: define void @_YT2B2GS1SE1b(ptr %self, ptr %closure)
// CHECK: define void @_YT1CGS1SE1c(ptr %self, ptr %closure)
