// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
fn main() {
  let x = 123;
  gc x;
  gc mut x;
}
// CHECK: fn main({{.*}}) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   $1 = 123
// CHECK-NEXT:   let x = $1
// CHECK-NEXT:   $2 = x
// CHECK-NEXT:   $3 = gc $2
// CHECK-NEXT:   $4 = x
// CHECK-NEXT:   $5 = gc mut $4
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }
