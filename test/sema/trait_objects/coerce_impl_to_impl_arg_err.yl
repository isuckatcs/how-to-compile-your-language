// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {}

trait B : A {}

trait C {}

fn foo(x: *any B) {
  // CHECK: [[# @LINE + 1 ]]:7: error: cannot unify '*any B' with '*any A'
  bar(x);
}

fn bar(x: *any A) {}

fn baz(x: *any A) {
  // CHECK: [[# @LINE + 1 ]]:7: error: cannot unify '*any A' with '*any B'
  foo(x);
}

fn main() {}
