// RUN: compiler %s 2>&1 -res-dump | filecheck %s
struct S<T> {
  x: *T
}

fn foo(x: unit) {}

fn bar<T>(t: T) {
  // CHECK: [[# @LINE + 1 ]]:7: error: cannot unify '(number) -> unit' with 'T'
  t = ->(x: number){};
}

fn baz(): S<*unit> {
  // CHECK: [[# @LINE + 1 ]]:10: error: cannot unify '(number) -> unit' with 'S<*unit>'
  return ->(x: number){};
}

fn main() {
  // CHECK: [[# @LINE + 1 ]]:19: error: cannot unify '(unit) -> unit' with 'number'
  let n: number = ->(x: unit){};

  // CHECK: [[# @LINE + 1 ]]:7: error: cannot unify '(S<unit>) -> unit' with 'unit'
  foo(->(x: S<unit>){});

  // CHECK: [[# @LINE + 1 ]]:10: error: cannot unify '() -> unit' with '*_'
  S { x: ->(){} };
}
