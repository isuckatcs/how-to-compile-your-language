// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {
  fn foo(self: &Self) {}
}

struct S {}

extension S : A {}

fn main() {
  let s = gc S{};
  s.foo();
  // CHECK: CallExpr {unit}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) foo {(&S) -> unit}
  // CHECK-NEXT:   ImplicitPtrToRefDecay {&S}
  // CHECK-NEXT:     DeclRefExpr @({{.*}}) s {*S}

  let s2 = gc mut S{};
  s2.foo();
  // CHECK: CallExpr {unit}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) foo {(&S) -> unit}
  // CHECK-NEXT:   ImplicitPtrToRefDecay {&S}
  // CHECK-NEXT:     DeclRefExpr @({{.*}}) s2 {*mut S}
}
