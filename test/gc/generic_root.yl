// RUN: compiler %s -o %t && YL_GC_DUMP=1 %t | filecheck %s
// RUN: %valgrind %t
fn detachRoot<T>(root: &mut T, replacement: T): T {
  let copy = root;
  root = replacement;

  gcCollect();
  // CHECK: [0] mark {{.*}} data: {{.*}} (8 B) {heap: 32 B, threshold: 96 B}
  // CHECK-NEXT: [0] sweep {heap: 32 B, threshold: 96 B}
  
  return copy;
}

fn one() {
  println(1);
}

fn two() {
  println(2);
}

fn main() {
  let x = 123;
  mut l = ->(){ println(x); };
  
  detachRoot(l, ->(){})();
  // CHECK-NEXT: 1
}
// CHECK-NEXT: [1] sweep {{.*}} data: {{.*}} (8 B) {heap: 0 B, threshold: 96 B}
// CHECK-NEXT: [1] sweep {heap: 0 B, threshold: 96 B}
