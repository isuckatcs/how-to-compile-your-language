// RUN: compiler %s 2>&1 -res-dump | filecheck %s
struct T<T> {}

trait Foo {
  // CHECK: [[# @LINE + 1 ]]:6: error: trait 'Foo' with a method returning a type referencing 'Self' cannot be used as a trait object
  fn val(self: &Self): Self;

  // CHECK: [[# @LINE + 1 ]]:6: error: trait 'Foo' with a method returning a type referencing 'Self' cannot be used as a trait object
  fn ptr(self: &Self): *Self;

  // CHECK: [[# @LINE + 1 ]]:6: error: trait 'Foo' with a method returning a type referencing 'Self' cannot be used as a trait object
  fn ptrMut(self: &Self): *mut Self;

  // CHECK: [[# @LINE + 1 ]]:6: error: trait 'Foo' with a method returning a type referencing 'Self' cannot be used as a trait object
  fn template(self: &Self): T<Self>;
}

struct S {}

extension S : Foo {
  fn val(self: &Self): Self {
    return S{};
  }

  fn ptr(self: &Self): *Self {
    return gc S{};
  }

  fn ptrMut(self: &Self): *mut Self {
    return gc mut S{};
  }

  fn template(self: &Self): T<Self> {
    return T{};
  }
}

fn main() {
  // CHECK: [[# @LINE + 1 ]]:19: error: trait 'Foo' is not trait object compatible
  mut x: *mut any Foo = gc mut S{};
}
