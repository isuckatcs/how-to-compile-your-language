// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait Base<T> {}

struct B<T> {}

extension<T> B<T> : Base<T> {}

trait A<T, U : Base<T>> {}

fn foo<T : A<T, B<T>>>() {}
// CHECK: FunctionDecl @({{.*}}) foo {() -> unit}
// CHECK-NEXT:   TypeParamDecl @({{.*}}) T {T}
// CHECK-NEXT:     TraitConformance T : A<T, B<T>>
// CHECK-NEXT:   Block

fn main() {}
