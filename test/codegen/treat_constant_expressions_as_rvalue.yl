// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzxe '123.456\n'
fn main() {
  let x = 123.456;
  println(x);
}
// CHECK: define void @_Y4main(ptr %closure) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   call void @_Y7println(double 1.234560e+02, ptr null)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }
