// RUN: compiler %s -res-dump 2>&1 | filecheck %s
struct S { b: bool }

struct Dummy<T> {}

trait A<T> {
  fn foo(self: &Self) {}
}

trait B<T> {
  fn bar(self: &Self) {}
}

extension S : A<bool> {}

extension<T, U : B<T>> U : A<Dummy<T>> {}

// S must satisfy A<T>. It is satisfied by both A<bool> and A<S>. What should T be?
extension<T, U : A<T>> U : B<T> {}

fn main() {
  let s = S { b: true };

  s.bar();
  // CHECK: [[# @LINE - 1 ]]:5: error: 'A<bool>' ambiguously satisfies requirement 'S : A<_>'
  // CHECK: [[# @LINE - 2 ]]:5: error: 'A<Dummy<_>>' ambiguously satisfies requirement 'S : A<_>'
  // CHECK: [[# @LINE - 3 ]]:5: error: explicit type annotations needed to disambiguate requirements

  S::bar();
  // CHECK: [[# @LINE - 1 ]]:6: error: 'A<bool>' ambiguously satisfies requirement 'S : A<_>'
  // CHECK: [[# @LINE - 2 ]]:6: error: 'A<Dummy<_>>' ambiguously satisfies requirement 'S : A<_>'
  // CHECK: [[# @LINE - 3 ]]:6: error: explicit type annotations needed to disambiguate requirements
}
