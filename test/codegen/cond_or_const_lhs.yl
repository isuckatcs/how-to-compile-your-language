// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '1\n'
fn foo(): number {
  mut cond1 = true;
  let cond2 = true;

  if cond1 || cond2 {
  // CHECK: br i1 %1, label %or.merge, label %or.rhs
    return 1;
  }

  return 0;
}

fn main() {
  println(foo());
}
