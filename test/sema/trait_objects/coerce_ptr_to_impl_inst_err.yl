// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {}

trait B {}

struct S {}

extension S : A {}

struct S2 {
  x: *any A
  y: *any B
}

fn main() {
  S2{ 
    // CHECK: [[# @LINE + 1 ]]:8: error: cannot unify '*mut S' with '*any A'
    x: gcMut(S{}),

    // CHECK: [[# @LINE + 1 ]]:8: error: cannot satisfy requirement 'S : B'
    y: gc(S{}),
  };
}
