// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n'
trait A {
  fn foo(self: &Self) {}
}

struct S {
  a: *any A,
  u: unit,
}

struct Wrapper {
  s: S
}

extension number : A {
  fn foo(self: &Self) {
    println(self);
  }
}

fn main() {
  // CHECK: %lambda.tmp1 = alloca { ptr, ptr }, align 8
  // CHECK: %traitObject = alloca { ptr, ptr }, align 8

  // CHECK: call void @llvm.gcroot(ptr %lambda.tmp1, ptr @function.offsets)
  // CHECK: call void @llvm.gcroot(ptr %traitObject, ptr @fat.ptr.offsets)

  mut l = ->(u: unit) {};
  l = ->(u: unit) {};

  mut s = S { a: gc 123, u: unit };
  S { a: s.a, u: gcCollect() }.a.foo();
  // CHECK: %8 = getelementptr inbounds nuw { { ptr, ptr } }, ptr %s, i32 0, i32 0
  // CHECK-NEXT: call void @llvm.memcpy.p0.p0.i64(ptr align 8 %traitObject, ptr align 8 %8, i64 16, i1 false)
  // CHECK-NEXT: call void @_Y9gcCollect(ptr null)
}
