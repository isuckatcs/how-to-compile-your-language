// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
fn main() {
  let l = ->() {
    mut x = 123;
    x = 456;
  };
  // CHECK: fn __builtin_lambda_call({{.*}}) {
  // CHECK-NEXT: bb2:
  // CHECK-NEXT:   preds: 
  // CHECK-NEXT:   succs: 1 
  // CHECK-NEXT: 
  // CHECK-NEXT: bb1:
  // CHECK-NEXT:   preds: 2 
  // CHECK-NEXT:   $1 = 123
  // CHECK-NEXT:   mut x = $1
  // CHECK-NEXT:   $2 = 456
  // CHECK-NEXT:   x = $2
  // CHECK-NEXT:   succs: 0 
  // CHECK-NEXT: 
  // CHECK-NEXT: bb0:
  // CHECK-NEXT:   preds: 1 
  // CHECK-NEXT:   succs: 
  // CHECK-NEXT: }
}
