// RUN: compiler %s -mono-dump 2>&1 | filecheck %s
struct S<T> {
  t: T
}

fn foo<T, U>(t: T, u: U) {
  bar(S{ t: t }, gc u);
}

fn bar<T, U>(t: T, u: U) {
  // CHECK: [[# @LINE + 1 ]]:3: error: overflow while instantiating 'foo' with '[U = S<*S<*S<*S<*S<*unit>>>>>, T = *S<*S<*S<*S<*S<number>>>>>]'
  foo(gc t, S{ t: u });
}

fn main() {
  foo(0, unit);
}
