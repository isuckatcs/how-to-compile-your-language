// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %valgrind %t

struct Empty {}

fn foo<T>(t: &T) {
  t;
}

fn main() {
  let u = gc unit;
  // CHECK: %0 = call ptr @gcAlloc(i32 0, ptr null)
  // CHECK-NEXT: store ptr %0, ptr %u, align 8

  foo(*u);
  // CHECK-NEXT: %1 = load ptr, ptr %u, align 8
  // CHECK-NEXT: call void @_Y3fooGuE(ptr %1, ptr null)

  let e = gc Empty {};
  // CHECK-NEXT: %2 = call ptr @gcAlloc(i32 0, ptr null)
  // CHECK-NEXT: store ptr %2, ptr %e, align 8

  foo(*e);
  // CHECK-NEXT: %3 = load ptr, ptr %e, align 8
  // CHECK-NEXT: call void @_Y3fooGS5EmptyE(ptr %3, ptr null)
}
