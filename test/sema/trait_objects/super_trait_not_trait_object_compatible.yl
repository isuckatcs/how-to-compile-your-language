// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait Foo {
  fn foo<T>(self: borrowed Self) {}
}

trait Bar : Foo {}

trait Baz : Bar {}

fn bar(x: *any Bar) {}
// CHECK: [[# @LINE - 8 ]]:6: error: trait 'Foo' with a template method cannot be used as a trait object
// CHECK: [[# @LINE - 2 ]]:16: error: super trait 'Foo' of trait 'Bar' is not trait object compatible
// CHECK: [[# @LINE - 3 ]]:16: error: trait 'Bar' is not trait object compatible

fn baz(x: *any Baz) {}
// CHECK: [[# @LINE - 13 ]]:6: error: trait 'Foo' with a template method cannot be used as a trait object
// CHECK: [[# @LINE - 2 ]]:16: error: super trait 'Foo' of trait 'Bar' is not trait object compatible
// CHECK: [[# @LINE - 3 ]]:16: error: super trait 'Bar' of trait 'Baz' is not trait object compatible
// CHECK: [[# @LINE - 4 ]]:16: error: trait 'Baz' is not trait object compatible

fn main() {}
