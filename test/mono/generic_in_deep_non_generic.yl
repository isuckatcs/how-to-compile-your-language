// RUN: compiler %s -mono-dump 2>&1 | filecheck %s
struct S {}

extension S {
  fn f1() { Self::f2(); }
  fn f2() { Self::f3(); }
  fn f3() { Self::f4(); }
  fn f4() { Self::f5(); }
  fn f5() { Self::f6(); }
  fn f6() { Self::f7(); }
  fn f7() { Self::f8(); }
  fn f8() { Self::f9(); }
  fn f9() { Self::f10(); }
  fn f10() { Self::f11(); }
  fn f11() { Self::f12(); }
  fn f12() { generic@<unit>(); }
}

fn generic<T>() {}

fn main() {
  S::f1();
}
// CHECK: (f1, []) -> _YS1S2f1
// CHECK-NEXT: (f2, []) -> _YS1S2f2
// CHECK-NEXT: (f3, []) -> _YS1S2f3
// CHECK-NEXT: (f4, []) -> _YS1S2f4
// CHECK-NEXT: (f5, []) -> _YS1S2f5
// CHECK-NEXT: (f6, []) -> _YS1S2f6
// CHECK-NEXT: (f7, []) -> _YS1S2f7
// CHECK-NEXT: (f8, []) -> _YS1S2f8
// CHECK-NEXT: (f9, []) -> _YS1S2f9
// CHECK-NEXT: (f10, []) -> _YS1S3f10
// CHECK-NEXT: (f11, []) -> _YS1S3f11
// CHECK-NEXT: (f12, []) -> _YS1S3f12
// CHECK-NEXT: (gcCollect, []) -> _Y9gcCollect
// CHECK-NEXT: (println, []) -> _Y7println
// CHECK-NEXT: (main, []) -> _Y4main
// CHECK-NEXT: (generic, [T = unit]) -> _Y7genericGuE
