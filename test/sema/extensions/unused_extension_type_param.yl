// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A<T> {}

trait B<T> {
  fn foo(self: &Self) {}
}

extension<T, U : A<T>> U : B<T> {}

// CHECK: [[# @LINE + 1 ]]:14: error: type parameter 'U' must be referenced by either the extended type or the extending trait
extension<T, U : B<T>> number : A<T> {}

fn main() {
  123.foo();
}
