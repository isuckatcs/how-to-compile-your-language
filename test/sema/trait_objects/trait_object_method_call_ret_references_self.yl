// RUN: compiler %s 2>&1 -res-dump | filecheck %s
struct T<T> {}

trait Foo {
  // CHECK: [[# @LINE + 1 ]]:6: error: trait 'Foo' with a method returning a type referencing 'Self' cannot be used as a trait object
  fn val(self: borrowed Self): Self;

  // CHECK: [[# @LINE + 1 ]]:6: error: trait 'Foo' with a method returning a type referencing 'Self' cannot be used as a trait object
  fn ptr(self: borrowed Self): *Self;

  // CHECK: [[# @LINE + 1 ]]:6: error: trait 'Foo' with a method returning a type referencing 'Self' cannot be used as a trait object
  fn ptrMut(self: borrowed Self): *mut Self;

  // CHECK: [[# @LINE + 1 ]]:6: error: trait 'Foo' with a method returning a type referencing 'Self' cannot be used as a trait object
  fn template(self: borrowed Self): T<Self>;
}

struct S {
  impl Foo {
    fn val(self: borrowed Self): Self {
      return S{};
    }

    fn ptr(self: borrowed Self): *Self {
      return gc(S{});
    }

    fn ptrMut(self: borrowed Self): *mut Self {
      return gcMut(S{});
    }

    fn template(self: borrowed Self): T<Self> {
      return T{};
    }
  }
}

fn main() {
  // CHECK: [[# @LINE + 1 ]]:19: error: trait 'Foo' is not trait object compatible
  mut x: *mut any Foo = gcMut(S{});
}
