// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n123\n123\n123\n123\n123\n'

// CHECK: @"vtable.S<number>.A<S<number>>" = internal constant [1 x ptr] [ptr @_YT1AGS1SGnEE3fooGS1SGnEE]
// CHECK: @"vtable.S<unit>.A<S<unit>>" = internal constant [1 x ptr] [ptr @_YT1AGS1SGuEE3fooGS1SGuEE]
// CHECK: @"vtable.S<() -> unit>.A<S<() -> unit>>" = internal constant [1 x ptr] [ptr @_YT1AGS1SGFRuEE3fooGS1SGFRuEE]

trait A<T> {
  fn foo(self: borrowed Self, t: T);
}

struct S<T> {
  x: T

  impl A<S<T>> {
    fn foo(self: borrowed Self, t: S<T>) {
      println(123);
    }
  }
}

fn foo<T : A<T>>(t: T) {
  let x: *impl A<T> = gc(t);
  x.foo(t);
}

struct X {
  x: number
}

fn main() {
  let sn = S@<number>{ x: 123 };
  foo(sn);
  sn.foo(sn);
  // CHECK: call void @_YT1AGS1SGnEE3fooGS1SGnEE(ptr %sn, ptr byval({ double }) %struct.arg.tmp1, ptr null)

  let su = S@<unit>{ x: unit };
  foo(su);
  su.foo(su);
  // CHECK: call void @_YT1AGS1SGuEE3fooGS1SGuEE(ptr %su, ptr null)

  let sf = S@<() -> unit>{ x: main };
  foo(sf);
  sf.foo(sf);
  // CHECK: call void @_YT1AGS1SGFRuEE3fooGS1SGFRuEE(ptr %sf, ptr byval({ { ptr, ptr } }) %struct.arg.tmp4, ptr null)
}

// CHECK: define void @_Y3fooGS1SGnEE(ptr byval({ double }) %t, ptr %closure) gc "shadow-stack" {
// CHECK:   %vFnPtr = getelementptr ptr, ptr %vtable, i32 0
// CHECK:   %vFn = load ptr, ptr %vFnPtr, align 8
// CHECK:   call void %vFn(ptr %obj, ptr byval({ double }) %struct.arg.tmp, ptr null)
// CHECK: }

// CHECK: define void @_Y3fooGS1SGuEE(ptr %closure) gc "shadow-stack" {
// CHECK:   %vFnPtr = getelementptr ptr, ptr %vtable, i32 0
// CHECK:   %vFn = load ptr, ptr %vFnPtr, align 8
// CHECK:   call void %vFn(ptr %obj, ptr null)
// CHECK: }

// CHECK: define void @_Y3fooGS1SGFRuEE(ptr byval({ { ptr, ptr } }) %t, ptr %closure) gc "shadow-stack" {
// CHECK:   %vFnPtr = getelementptr ptr, ptr %vtable, i32 0
// CHECK:   %vFn = load ptr, ptr %vFnPtr, align 8
// CHECK:   call void %vFn(ptr %obj, ptr byval({ { ptr, ptr } }) %struct.arg.tmp, ptr null)
// CHECK: }
