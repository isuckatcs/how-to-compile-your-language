// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
struct S<T> {}

extension<T> S<T> {
  fn foo<U>() {}
}

trait A {
  fn foo() {}
}

struct S2 {}

extension S2 : A {}

fn main() {
  S@<number>::foo@<number>();

  @<S2 : A>::foo();
}
// CHECK: fn main({{.*}}) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   $1 = foo
// CHECK-NEXT:   $2 = $1()
// CHECK-NEXT:   $3 = foo
// CHECK-NEXT:   $4 = $3()
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }