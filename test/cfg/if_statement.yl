fn multipleBranches(): unit {
    if true {
        7;
    } else if true {
        5;
    } else if true {
        3;
    } else {
        2;
    }

    1;
}
// CHECK: fn multipleBranches(...) {
// CHECK-NEXT: bb9:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 8 
// CHECK-NEXT: 
