// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '0\n1\n2\n3\n0\n1\n2\n3\n'
trait A {
  fn a(self: &Self) { println(0); }
}

trait B1 : A {
  fn b(self: &Self) { println(1); }
}

trait B2 : A {
  fn b(self: &Self) { println(2); }
}

trait C : B1 & B2 {
  fn c(self: &Self) { println(3); }
}

struct S { 
  a: number,
  b1: number,
  b2: number,
  c: number,
}

extension S : A {
  fn a(self: &Self) { println(self.a); }
}

extension S : B1 {
  fn b(self: &Self) { println(self.b1); }
}

extension S : B2 {
  fn b(self: &Self) { println(self.b2); }
}

extension S : C {
  fn c(self: &Self) { println(self.c); }
}

fn generateVtable(c: *any C) {
  c.a();
  @<any C : B1>::b(c);
  @<any C : B2>::b(c);
  c.c();
}

fn main() {
  let s = gc S { a: 0, b1: 1, b2: 2, c: 3 };

  generateVtable(s);

  // CHECK: @vtable.T1CGS1SE = internal constant [4 x ptr] [ptr @_YT1AGS1SE1a, ptr @_YT2B1GS1SE1b, ptr @_YT2B2GS1SE1b, ptr @_YT1CGS1SE1c]

  s.a();
  // CHECK: call void @_YT1AGS1SE1a(ptr %8, ptr null)

  @<S : B1>::b(s);
  // CHECK: call void @_YT2B1GS1SE1b(ptr %9, ptr null)
  
  @<S : B2>::b(s);
  // CHECK: call void @_YT2B2GS1SE1b(ptr %10, ptr null)
  
  s.c();
  // CHECK: call void @_YT1CGS1SE1c(ptr %11, ptr null)
}
