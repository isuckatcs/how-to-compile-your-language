// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n'

// CHECK: @vtable.T1AGS1SGnEnE = internal constant [1 x ptr] [ptr @_YT1AGS1SGnEnE3foo]

trait A<T> {
  fn foo(self: &Self) {
    println(123);
  }
}

struct S<T> {}

extension<T> S<T> : A<T> {}

fn foo<T>(x: *any A<T>) {
  x.foo();
}

fn main() {
  foo(gc S@<number>{});
}
