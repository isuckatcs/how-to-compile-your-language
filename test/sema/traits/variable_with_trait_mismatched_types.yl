// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A {}

trait B<T> {}

struct S {}

struct S2 {}

extension S : A {}

extension S2 : B<S> {}

fn foo<T : A, U : B<T>>() {
  let u: U;
  let s2 = S2{};

  // CHECK: [[# @LINE + 1]]:7: error: expected to assign 'U' but received 'S2' instead
  u = s2;
}

fn main() {}
