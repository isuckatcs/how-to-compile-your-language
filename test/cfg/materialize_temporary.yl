// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
trait A {
  fn foo(self: &Self);
}

extension number : A {
  fn foo(self: &Self) {
    println(self);
  }
}

fn foo(n: number): number {
  return n;
}

fn main() {
  let x = 123;
  foo(x).foo();
}
// CHECK: fn main({{.*}}) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   $1 = 123
// CHECK-NEXT:   let x = $1
// CHECK-NEXT:   $2 = x
// CHECK-NEXT:   $3 = foo
// CHECK-NEXT:   $4 = $3($2)
// CHECK-NEXT:   $5 = (materialize) $4
// CHECK-NEXT:   $6 = (& <-) $5
// CHECK-NEXT:   $7 = foo
// CHECK-NEXT:   $8 = $7($6)
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }
