// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A<T> {
  fn foo(self: borrowed Self, t: T) {}
}

struct S<T> {
  impl A<T>;
}

fn foo<T : A<T>>(t: T) {
  let x: *impl A<T> = gc(t);
  // CHECK: DeclStmt
  // CHECK-NEXT:   VarDecl @({{.*}}) x {*impl A<T>}
  // CHECK-NEXT:     TraitObjectPromoExpr {*impl A<T>}
  // CHECK-NEXT:       GCExpr {*T}
}

fn main() {}
