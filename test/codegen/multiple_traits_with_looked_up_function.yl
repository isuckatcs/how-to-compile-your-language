// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n'
trait A {
  fn foo(self: &Self) {
    println(123);
  }
}

trait B {
  fn foo(self: &Self) {}
}

extension number : A {}

fn main() {
  123.foo();
  // CHECK: call void @_YT1AGnE3foo(ptr %materialize.tmp, ptr null)
}
