// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A<T> {
  fn foo();
}

struct S {}

// CHECK: [[# @LINE + 1]]:15: error: type argument count mismatch, expected 1, but received 0
extension S : A {
  fn foo() {}
}

// CHECK: [[# @LINE + 1]]:15: error: type argument count mismatch, expected 1, but received 2
extension S : A<number, unit> {
  fn foo() {}
}

fn main() {}
