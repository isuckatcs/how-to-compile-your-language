// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
fn main(): unit {
    mut x: number;

    x = 2.0;

    x = 3.0;

    x = x + 1.0;
}
// CHECK: fn main({{.*}}) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   mut x
// CHECK-NEXT:   $1 = 2
// CHECK-NEXT:   x = $1
// CHECK-NEXT:   $2 = 3
// CHECK-NEXT:   x = $2
// CHECK-NEXT:   $3 = x
// CHECK-NEXT:   $4 = 1
// CHECK-NEXT:   $5 = $3 + $4
// CHECK-NEXT:   x = $5
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }
