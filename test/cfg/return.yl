// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
fn foo(): number {
    3.0;
    return 3.0;

    2.0;
    return 2.0;

    return 1.0;
}
// CHECK: fn foo({{.*}}) {
// CHECK-NEXT: bb4:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 3 
// CHECK-NEXT: 
// CHECK-NEXT: bb3:
// CHECK-NEXT:   preds: 4 
// CHECK-NEXT:   $1 = 3
// CHECK-NEXT:   $2 = 3
// CHECK-NEXT:   return $2
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   $3 = 2
// CHECK-NEXT:   $4 = 2
// CHECK-NEXT:   return $4
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   $5 = 1
// CHECK-NEXT:   return $5
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 2 3 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }

fn main(): unit {}
