// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {}

trait B {}

struct S {}

extension S : A {}

fn foo(mut x: *any A, y: *any B) {
  // CHECK: [[# @LINE + 1 ]]:7: error: expected to assign '*any A' but received '*mut S' instead
  x = gc mut S{};
  
  // CHECK: [[# @LINE + 1 ]]:7: error: cannot satisfy requirement 'S : B'
  y = gc S{};
}

fn main() {}
