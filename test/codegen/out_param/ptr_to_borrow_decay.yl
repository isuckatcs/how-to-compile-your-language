// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n'
trait A {
  fn foo(self: &Self) {
    println(123);
  }
}

struct S {}

extension S : A {}

fn main() {
  let s = gc(S{});
  // CHECK: %0 = call ptr @gcAlloc(i32 0, ptr null)
  // CHECK-NEXT: store ptr %0, ptr %s, align 8

  s.foo();
  // CHECK-NEXT: %1 = load ptr, ptr %s, align 8
  // CHECK-NEXT: call void @_YT1AGS1SE3foo(ptr %1, ptr null)
}
