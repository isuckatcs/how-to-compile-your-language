// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A {}

trait B<T> {}

struct S {}

extension S : A {}

struct S2 {}

extension S2 : B<S> {}

fn foo<T, U : B<T>>(x: T, y: U) {}
fn bar<T, U : B<T>>(x: U, y: T) {}

fn main() {
  let s = S2{};

  let f = foo;
  let b = bar;

  f(0, s);
  // CHECK: [[# @LINE - 1 ]]:8: error: cannot satisfy requirement 'S2 : B<number>'


  b(s, 0);
  // CHECK: [[# @LINE - 1 ]]:8: error: cannot unify 'number' with 'S'

  foo(0, s);
  // CHECK: [[# @LINE - 1 ]]:10: error: cannot satisfy requirement 'S2 : B<number>'

  bar(s, 0);
  // CHECK: [[# @LINE - 1 ]]:10: error: cannot unify 'number' with 'S'
}
