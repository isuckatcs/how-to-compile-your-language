// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {}

trait B : A {}

trait C {}

fn foo(x: *any B): *any C {
  // CHECK: [[# @LINE + 1 ]]:10: error: cannot unify '*any B' with '*any C'
  return x;
}

fn bar(x: *any A): *any B {
  // CHECK: [[# @LINE + 1 ]]:10: error: cannot unify '*any A' with '*any B'
  return x;
}

fn main() {}
