// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
struct S {
  x: number,
  s2: S2,
  y: number,
}

struct S2 {
  y: number
}

fn main(): unit {
  let s = S { s2: S2 { y : 1 }, x: 0, y: 2 };
  let s2 = S { x: 3, s2: S2 { y : 4 }, y: 5 };
}
// CHECK: fn main({{.*}}) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   $1 = 1
// CHECK-NEXT:   $2 = S2 { y: $1 }
// CHECK-NEXT:   $3 = 0
// CHECK-NEXT:   $4 = 2
// CHECK-NEXT:   $5 = S { s2: $2, x: $3, y: $4 }
// CHECK-NEXT:   let s = $5
// CHECK-NEXT:   $6 = 3
// CHECK-NEXT:   $7 = 4
// CHECK-NEXT:   $8 = S2 { y: $7 }
// CHECK-NEXT:   $9 = 5
// CHECK-NEXT:   $10 = S { x: $6, s2: $8, y: $9 }
// CHECK-NEXT:   let s2 = $10
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }
