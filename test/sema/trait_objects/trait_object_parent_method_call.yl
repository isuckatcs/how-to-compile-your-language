// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {
  fn foo(self: &Self, x: number) {}
}

trait B : A {}

fn foo(x: *mut any B) {
  x.foo(123);
}
// CHECK: FunctionDecl @({{.*}}) foo {(*mut any B) -> unit}
// CHECK-NEXT:   ParamDecl @({{.*}}) x {*mut any B}
// CHECK-NEXT:   Block
// CHECK-NEXT:     CallExpr {unit}
// CHECK-NEXT:       DeclRefExpr @({{.*}}) foo {(&any B, number) -> unit}
// CHECK-NEXT:       ImplicitPtrToRefDecay {&any B}
// CHECK-NEXT:         DeclRefExpr @({{.*}}) x {*mut any B}
// CHECK-NEXT:       NumberLiteral '123' {number}
// CHECK-NEXT:       | value: 123

fn main() {}
