// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A {
  fn foo(self: &Self);
}

extension number : A {
  fn foo(self: &Self) {
    println(self);
  }
}

fn foo(n: number): number {
  return n;
}

fn main() {
  let x;

  // CHECK: [[# @LINE + 1 ]]:7: error: 'x' is not initialized
  foo(x).foo();
}
