// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %valgrind %t
struct S2 {
  x: unit,
  y: unit
}

fn foo(): S2 {
  return S2 { x: unit, y: unit };
}

fn bar(u: &unit) {}

fn main() {
  // CHECK: %0 = alloca [0 x i8], align 1

  bar(foo().x);
  // CHECK-NEXT: call void @_Y3foo(ptr null)
  // CHECK-NEXT: call void @_Y3bar(ptr %0, ptr null)
}
