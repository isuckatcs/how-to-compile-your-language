// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A {
  fn typeLevel() {}

  fn instanceLevel(self: &Self) {}
}

extension number : A {
  fn typeLevel() {
    println(123);
  }

  fn instanceLevel(self: &Self) {
    Self::typeLevel();
  }
  // CHECK: FunctionDecl @({{.*}}) instanceLevel {(&number) -> unit}
  // CHECK-NEXT:   ParamDecl @({{.*}}) self {&number}
  // CHECK-NEXT:   Block
  // CHECK-NEXT:     CallExpr {unit}
  // CHECK-NEXT:       DeclRefExpr @({{.*}}) typeLevel {() -> unit}
}

fn main() {
  123.instanceLevel();
}
