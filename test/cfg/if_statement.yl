// CHECK-NEXT:   $6 = 3
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 4(U) 
// CHECK-NEXT:   $7 = 2
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 3 5 7 
// CHECK-NEXT:   $8 = 1
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }

fn nestedIfStatements(): unit {
    if true {
        if true {
            3;
        } else {
            2;
