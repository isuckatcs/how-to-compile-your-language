// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {}

trait Foo<T : A> {
  fn foo(self: &Self) {}
}

fn main() {
  // CHECK: [[# @LINE + 1 ]]:19: error: cannot satisfy requirement 'number : A'
  let x: *any Foo<number>;

  // CHECK: [[# @LINE + 1 ]]:3: error: symbol 'x' not found
  x.foo();
}
