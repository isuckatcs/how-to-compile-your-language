// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {}

trait B : A {}

trait C {}

struct S {}

extension S : A {}

fn foo(x: *any A, mut y: *any B, mut z: *any C) {
  // CHECK: [[# @LINE + 1 ]]:7: error: expected to assign '*any B' but received '*any A' instead
  y = x;
  
  // CHECK: [[# @LINE + 1 ]]:7: error: expected to assign '*any C' but received '*any B' instead
  z = y;
}

fn main() {}
