// RUN: compiler %s -res-dump 2>&1 | filecheck %s
struct S {
  x: number
}

fn main(): unit { 
  mut x;
  mut y;

  y = x;
  y = 2;

  // CHECK: [[# @LINE + 1 ]]:9: error: cannot unify 'S' with 'number'
  x = S { x: 1 };
  // CHECK: [[# @LINE + 1 ]]:9: error: cannot unify 'S' with 'number'
  y = S { x: 1 };
}

// CHECK-NOT: {{.*error.*}}
