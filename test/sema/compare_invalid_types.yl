// RUN: compiler %s -res-dump 2>&1 | filecheck %s
struct S {}

fn foo<T>(t1: T, t2: T) {
  // CHECK: [[# @LINE + 1 ]]:6: error: incompatible operands to binary operator ('T' and 'T')
  t1 == t2;
}

fn main() {
  let s1 = S{};
  let s2 = S{};

  // CHECK: [[# @LINE + 1 ]]:6: error: incompatible operands to binary operator ('S' and 'S')
  s1 == s2;
}
