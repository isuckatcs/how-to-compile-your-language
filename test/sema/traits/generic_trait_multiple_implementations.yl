// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait B<T> {}

trait A<T, U> : B<T> & B<U> {}

struct Empty {}

struct S<T, U> {
  impl A<Empty, number>;
  impl A<number, Empty>;
  impl B<Empty>;
  impl B<number>;
}

fn foo<T, U, V : B<T> & B<U>>(v: V) {}

fn main() {
  let s = S@<Empty, number>{};

  foo(s);
  // CHECK: [[# @LINE - 1 ]]:7: error: 'B<Empty>' ambigously satisfies requirement 'S<Empty, number> : B<_>'
  // CHECK: [[# @LINE - 2 ]]:7: error: 'B<number>' ambigously satisfies requirement 'S<Empty, number> : B<_>'
  // CHECK: [[# @LINE - 3 ]]:7: error: 'B<Empty>' ambigously satisfies requirement 'S<Empty, number> : B<_>'
  // CHECK: [[# @LINE - 4 ]]:7: error: 'B<number>' ambigously satisfies requirement 'S<Empty, number> : B<_>'
}
