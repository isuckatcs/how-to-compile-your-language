// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %valgrind %t
struct S {
  x: number,
  y: unit,
  z: number,
  w: unit,
}

fn foo(s: S) {
  bar(s.x, s.y, s.z, s.w);
}
// CHECK: define void @_Y3foo(ptr byval({ double, double }) %s, ptr %closure) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   %0 = getelementptr inbounds nuw { double, double }, ptr %s, i32 0, i32 0
// CHECK-NEXT:   %1 = getelementptr { double, double }, ptr %s, i64 1
// CHECK-NEXT:   %2 = getelementptr inbounds nuw { double, double }, ptr %s, i32 0, i32 1
// CHECK-NEXT:   %3 = getelementptr { double, double }, ptr %s, i64 1
// CHECK-NEXT:   call void @_Y3bar(ptr %0, ptr %1, ptr %2, ptr %3, ptr null)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }

fn bar(x: &number, y: &unit, z: &number, w: &unit) {}

fn main() {}
