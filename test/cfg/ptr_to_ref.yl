// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
fn foo(n: &number) {}

fn main() {
  let x = gc 123;
  foo(x);
}
// CHECK: fn main({{.*}}) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   $1 = 123
// CHECK-NEXT:   $2 = gc $1
// CHECK-NEXT:   let x = $2
// CHECK-NEXT:   $3 = x
// CHECK-NEXT:   $4 = (& <- *) $3
// CHECK-NEXT:   $5 = foo
// CHECK-NEXT:   $6 = $5($4)
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }
