// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait Foo {
  fn out(self: &Self, x: &any Foo) {}
  fn ptr(self: &Self, x: *any Foo) {}
  fn mutPtr(self: &Self, x: *mut any Foo) {}
}

struct S {}

extension S : Foo {}

fn foo(p: &any Foo) {
  mut x: *mut any Foo = gc mut S{};

  x.out(p);
  // CHECK: CallExpr {unit}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) out {(&any Foo, &any Foo) -> unit}
  // CHECK-NEXT:   ImplicitPtrToRefDecay {&any Foo}
  // CHECK-NEXT:     DeclRefExpr @({{.*}}) x {*mut any Foo}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) p {&any Foo}

  x.ptr(gc S{});
  // CHECK: CallExpr {unit}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) ptr {(&any Foo, *any Foo) -> unit}
  // CHECK-NEXT:   ImplicitPtrToRefDecay {&any Foo}
  // CHECK-NEXT:     DeclRefExpr @({{.*}}) x {*mut any Foo}
  // CHECK-NEXT:   TraitObjectPromoExpr {*any Foo}
  // CHECK-NEXT:     GCExpr {*S}
  // CHECK-NEXT:       StructInstantiationExpr {S}
  // CHECK-NEXT:         DeclRefExpr @({{.*}}) S {S}

  x.mutPtr(x);
  // CHECK: CallExpr {unit}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) mutPtr {(&any Foo, *mut any Foo) -> unit}
  // CHECK-NEXT:   ImplicitPtrToRefDecay {&any Foo}
  // CHECK-NEXT:     DeclRefExpr @({{.*}}) x {*mut any Foo}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) x {*mut any Foo}
}

fn main() {}
