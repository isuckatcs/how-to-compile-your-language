// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
fn main() {
    let x = 0;
    let y = 1;
    let z = 2;

    let l = ->(){ y + z + x; };
}
// CHECK: fn main(...) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   $1 = 0
// CHECK-NEXT:   let x = $1
// CHECK-NEXT:   $2 = 1
// CHECK-NEXT:   let y = $2
// CHECK-NEXT:   $3 = 2
// CHECK-NEXT:   let z = $3
// CHECK-NEXT:   $4 = y
// CHECK-NEXT:   $5 = z
// CHECK-NEXT:   $6 = x
// CHECK-NEXT:   $7 = ->[$4, $5, $6](...){...}
// CHECK-NEXT:   let l = $7
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }

fn nonCapturing() {
    let l = ->(){};
}
// CHECK: fn nonCapturing(...) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   $1 = ->[](...){...}
// CHECK-NEXT:   let l = $1
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }
