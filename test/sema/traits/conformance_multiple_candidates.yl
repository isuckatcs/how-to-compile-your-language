// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A<T> {}

struct Dummy<T> {}

struct S {}

extension S : A<unit> {}
extension S : A<number> {}

fn foo<T, U: A<T>>(u: U) {}

fn main() {
  foo(S{});
  // CHECK: [[# @LINE - 1 ]]:8: error: 'A<unit>' ambigously satisfies requirement 'S : A<_>'
  // CHECK: [[# @LINE - 2 ]]:8: error: 'A<number>' ambigously satisfies requirement 'S : A<_>'
}
