// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n'
trait A {}

struct S {}

extension S : A {}

fn main() {
  let s: *any A = gc S {};
  // CHECK: %0 = call ptr @gcAlloc(i32 0, ptr null)
  // CHECK-NEXT: %1 = getelementptr inbounds nuw { ptr, ptr }, ptr %traitObject, i32 0, i32 0
  // CHECK-NEXT: store ptr %0, ptr %1, align 8
  // CHECK-NEXT: %2 = getelementptr inbounds nuw { ptr, ptr }, ptr %traitObject, i32 0, i32 1
  // CHECK-NEXT: store ptr null, ptr %2, align 8

  println(123);
}
// CHECK-NOT: {{.*@vtable.*}}
