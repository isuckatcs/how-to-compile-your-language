// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '3\n'
trait A {
  fn a(self: borrowed Self) { println(0); }
}

trait B1 : A {
  fn b(self: borrowed Self) { println(1); }
}

trait B2 : A {
  fn b(self: borrowed Self) { println(2); }
}

trait C : B1 & B2 {
  fn c(self: borrowed Self) { println(3); }
}

struct S {
  impl A;
  impl B1;
  impl B2;
  impl C;
}

fn main() {
  let s: *impl C = gc(S {});
  s.c();
}

// CHECK: @vtable.S.C = internal constant [5 x ptr] [ptr @_YT1A1aGS1SE, ptr @_YT2B11bGS1SE, ptr @_YT1A1aGS1SE, ptr @_YT2B21bGS1SE, ptr @_YT1C1cGS1SE]
// CHECK: define void @_YT1A1aGS1SE(ptr %self, ptr %closure)
// CHECK: define void @_YT2B11bGS1SE(ptr %self, ptr %closure)
// CHECK: define void @_YT2B21bGS1SE(ptr %self, ptr %closure)
// CHECK: define void @_YT1C1cGS1SE(ptr %self, ptr %closure)
