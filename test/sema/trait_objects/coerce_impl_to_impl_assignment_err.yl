// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {}

trait B : A {}

trait C {}

struct S {}

extension S : A {}

fn foo(x: *any A, mut y: *any B, mut z: *any C) {
  // CHECK: [[# @LINE + 1 ]]:7: error: cannot unify '*any A' with '*any B'
  y = x;
  
  // CHECK: [[# @LINE + 1 ]]:7: error: cannot unify '*any B' with '*any C'
  z = y;
}

fn main() {}
