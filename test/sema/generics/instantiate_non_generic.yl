// RUN: compiler %s -res-dump 2>&1 | filecheck %s
struct S { x: number }

fn main(): unit {
  // CHECK: [[# @LINE + 1 ]]:4: error: 'S' is not a generic
  S@<number>{ x: 1 };

  // CHECK: [[# @LINE + 1 ]]:7: error: 'main' is not a generic
  main@<unit>();

  let a = 0;

  // CHECK: [[# @LINE + 1 ]]:4: error: 'a' is not a generic
  a@<number>;
}

// CHECK-NOT: {{.*error.*}}
