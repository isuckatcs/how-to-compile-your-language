// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A {}

extension unit : A {}

extension<T : A> T : A {}
// CHECK: [[# @LINE - 1 ]]:20: error: extension 'T : A' conflicts with extension 'unit : A' for type 'unit'

extension<T : A> T : A {}
// CHECK: [[# @LINE - 1 ]]:20: error: extension 'T : A' conflicts with extension 'unit : A' for type 'unit'

extension<T : A> T : A {}
// CHECK: [[# @LINE - 1 ]]:20: error: extension 'T : A' conflicts with extension 'unit : A' for type 'unit'

extension<T : A> T : A {}
// CHECK: [[# @LINE - 1 ]]:20: error: extension 'T : A' conflicts with extension 'unit : A' for type 'unit'

extension<T : A> T : A {}
// CHECK: [[# @LINE - 1 ]]:20: error: extension 'T : A' conflicts with extension 'unit : A' for type 'unit'

extension<T : A> T : A {}
// CHECK: [[# @LINE - 1 ]]:20: error: extension 'T : A' conflicts with extension 'unit : A' for type 'unit'

fn main() {}
