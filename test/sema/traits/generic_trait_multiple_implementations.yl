// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait B<T> {}

trait A<T, U> : B<T> & B<U> {}

struct Empty {}

struct S<T, U> {}

extension<T, U> S<T, U> : A<Empty, number> {}
extension<T, U> S<T, U> : A<number, Empty> {}
extension<T, U> S<T, U> : B<Empty> {}
extension<T, U> S<T, U> : B<number> {}

fn foo<T, U, V : B<T> & B<U>>(v: V) {}

fn main() {
  let s = S@<Empty, number>{};

  foo(s);
  // CHECK: [[# @LINE - 1 ]]:7: error: 'B<Empty>' ambiguously satisfies requirement 'S<Empty, number> : B<_>'
  // CHECK: [[# @LINE - 2 ]]:7: error: 'B<number>' ambiguously satisfies requirement 'S<Empty, number> : B<_>'
  // CHECK: [[# @LINE - 3 ]]:7: error: explicit type annotations needed to disambiguate requirements
}
// CHECK-NOT: {{.*error.*}}
