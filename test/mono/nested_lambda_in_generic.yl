// RUN: compiler %s -mono-dump 2>&1 | filecheck %s
fn wrapper<T>(t: T): T {
  return ->(){
    return ->(){ return t; }();
  }();
}

fn main() {
  wrapper(123);
  wrapper(unit);
  wrapper(main);
}
// CHECK: (__builtin_lambda_call, [T = number]) -> _Y7wrapperGnES8lambda_021__builtin_lambda_callS8lambda_021__builtin_lambda_call
// CHECK-NEXT: (__builtin_lambda_call, [T = unit]) -> _Y7wrapperGuES8lambda_021__builtin_lambda_callS8lambda_021__builtin_lambda_call
// CHECK-NEXT: (__builtin_lambda_call, [T = () -> unit]) -> _Y7wrapperGFRuES8lambda_021__builtin_lambda_callS8lambda_021__builtin_lambda_call
