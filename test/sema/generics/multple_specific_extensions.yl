// RUN: compiler %s -res-dump 2>&1 | filecheck %s
struct S<T> {}

extension<T> S<T> {
  fn foo(self: &Self) {
    println(123);
  }
}

extension S<unit> {
  // CHECK: [[# @LINE + 1 ]]:6: error: redeclaration of 'foo'
  fn foo(self: &Self) {
    println(123);
  }
}

extension S<number> {
  // CHECK: [[# @LINE + 1 ]]:6: error: redeclaration of 'foo'
  fn foo(self: &Self) {
    println(456);
  }
}

fn foo<T>() {
  let s = S@<T>{};
  s.foo();
}

fn main() {
  foo@<unit>();
  foo@<number>();
  foo@<(number) -> unit>();
}
