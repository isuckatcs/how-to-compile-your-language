// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A {
  fn foo(self: &Self) {}
}

trait B {
  fn foo(self: &Self) {}
}

extension number : A {}

fn main() {
  123.foo();
  // CHECK: CallExpr {unit}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) foo {(&number) -> unit}
  // CHECK-NEXT:   ImplicitAsRefExpr {&number}
  // CHECK-NEXT:     MaterializeTemporaryExpr {number}
  // CHECK-NEXT:       NumberLiteral '123' {number}
}
