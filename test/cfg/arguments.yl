// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
fn foo(x: number, y: number): unit{}

fn main(): unit {
    foo(1.0 + 2.0, 3.0 + 4.0);
}
// CHECK: fn main({{.*}}) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   $1 = 1
// CHECK-NEXT:   $2 = 2
// CHECK-NEXT:   $3 = $1 + $2
// CHECK-NEXT:   $4 = 3
// CHECK-NEXT:   $5 = 4
// CHECK-NEXT:   $6 = $4 + $5
// CHECK-NEXT:   $7 = foo
// CHECK-NEXT:   $8 = $7($3, $6)
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }
