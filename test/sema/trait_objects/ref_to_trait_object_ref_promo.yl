// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {}

extension number : A {}

fn foo(a: &any A) {}

fn bar(n: &number) {
  foo(n);
  // CHECK: CallExpr {unit}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) foo {(&any A) -> unit}
  // CHECK-NEXT:   TraitObjectPromoExpr {&any A}
  // CHECK-NEXT:     DeclRefExpr @({{.*}}) n {&number}
}

fn main() {}
