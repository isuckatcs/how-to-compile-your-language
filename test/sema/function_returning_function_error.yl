// RUN: compiler %s -res-dump 2>&1 | filecheck %s
fn foo(): number {
  return 0;
}

fn bar(): (number) -> number {
  // CHECK: [[# @LINE + 1 ]]:10: error: cannot unify '() -> number' with '(number) -> number'
  return foo;
}

fn main(): unit { 
  // CHECK: [[# @LINE + 1 ]]:26: error: cannot unify '(number) -> number' with '() -> unit'
  let f: () -> unit = bar();
}

// CHECK-NOT: {{.*error.*}}
