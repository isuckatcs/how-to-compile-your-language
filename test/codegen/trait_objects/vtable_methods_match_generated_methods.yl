// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '0\n1\n2\n3\n0\n1\n2\n3\n'
trait A {
  fn a(self: &Self) { println(0); }
}

trait B1 : A {
  fn b(self: &Self) { println(1); }
}

trait B2 : A {
  fn b(self: &Self) { println(2); }
}

trait C : B1 & B2 {
  fn c(self: &Self) { println(3); }
}

struct S {}

extension S : A {}

extension S : B1 {}

extension S : B2 {}

extension S : C {}

fn generateVtable(c: *any C) {
  c.a();
  @<any C : B1>::b(c);
  @<any C : B2>::b(c);
  c.c();
}

fn main() {
  let s = gc S {};

  generateVtable(s);

  // CHECK: @vtable.T1CGS1SE = internal constant [4 x ptr] [ptr @_YT1AGS1SE1a, ptr @_YT2B1GS1SE1b, ptr @_YT2B2GS1SE1b, ptr @_YT1CGS1SE1c]

  s.a();
  // CHECK: call void @_YT1AGS1SE1a(ptr %4, ptr null)

  @<S : B1>::b(s);
  // CHECK: call void @_YT2B1GS1SE1b(ptr %5, ptr null)
  
  @<S : B2>::b(s);
  // CHECK: call void @_YT2B2GS1SE1b(ptr %6, ptr null)
  
  s.c();
  // CHECK: call void @_YT1CGS1SE1c(ptr %7, ptr null)
}
