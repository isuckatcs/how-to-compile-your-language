// RUN: compiler %s -mono-dump 2>&1 | filecheck %s
fn wrapper<T>(t: T): T {
  return ->(){ return t; }();
}

fn main() {
  wrapper(123);
  wrapper(unit);
  wrapper(main);
}
// CHECK: (__builtin_lambda_call, [T = number]) -> _YY7wrapperGnES8lambda_021__builtin_lambda_call
// CHECK-NEXT: (__builtin_lambda_call, [T = unit]) -> _YY7wrapperGuES8lambda_021__builtin_lambda_call
// CHECK-NEXT: (__builtin_lambda_call, [T = () -> unit]) -> _YY7wrapperGFRuES8lambda_021__builtin_lambda_call
