// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n456\n'

// CHECK: @vtable.T1AGnE = internal constant [1 x ptr] [ptr @_YT1AGnE3foo]
// CHECK: @vtable.T1AGuE = internal constant [1 x ptr] [ptr @_YT1AGuE3foo]

trait A {
  fn foo(self: &Self) {}
}

extension number : A {
  fn foo(self: &Self) {
    println(self);
  }
}

extension unit : A {
  fn foo(self: &Self) {
    println(456);
  }
}

fn main() {
  let n = gc(123);
  @<any A : A>::foo(n);
  // CHECK: %0 = call ptr @gcAlloc(i32 8, ptr null)
  // CHECK-NEXT: store double 1.230000e+02, ptr %0, align 8
  // CHECK-NEXT: store ptr %0, ptr %n, align 8
  // CHECK-NEXT: %1 = load ptr, ptr %n, align 8
  // CHECK-NEXT: %2 = getelementptr inbounds nuw { ptr, ptr }, ptr %traitObject, i32 0, i32 0
  // CHECK-NEXT: store ptr %1, ptr %2, align 8
  // CHECK-NEXT: %3 = getelementptr inbounds nuw { ptr, ptr }, ptr %traitObject, i32 0, i32 1
  // CHECK-NEXT: store ptr @vtable.T1AGnE, ptr %3, align 8

  // CHECK: %vtablePtr = getelementptr inbounds nuw { ptr, ptr }, ptr %decay, i32 0, i32 1
  // CHECK-NEXT: %vtable = load ptr, ptr %vtablePtr, align 8
  // CHECK-NEXT: %vFnPtr = getelementptr ptr, ptr %vtable, i32 0
  // CHECK-NEXT: %vFn = load ptr, ptr %vFnPtr, align 8
  // CHECK-NEXT: call void %vFn(ptr %obj, ptr null)

  let u = gc(unit);
  @<any A : A>::foo(u);
  // CHECK: %6 = call ptr @gcAlloc(i32 0, ptr null)
  // CHECK-NEXT: store ptr %6, ptr %u, align 8
  // CHECK-NEXT: %7 = load ptr, ptr %u, align 8
  // CHECK-NEXT: %8 = getelementptr inbounds nuw { ptr, ptr }, ptr %traitObject1, i32 0, i32 0
  // CHECK-NEXT: store ptr %7, ptr %8, align 8
  // CHECK-NEXT: %9 = getelementptr inbounds nuw { ptr, ptr }, ptr %traitObject1, i32 0, i32 1
  // CHECK-NEXT: store ptr @vtable.T1AGuE, ptr %9, align 8

  // CHECK: %vtablePtr5 = getelementptr inbounds nuw { ptr, ptr }, ptr %decay2, i32 0, i32 1
  // CHECK-NEXT: %vtable6 = load ptr, ptr %vtablePtr5, align 8
  // CHECK-NEXT: %vFnPtr7 = getelementptr ptr, ptr %vtable6, i32 0
  // CHECK-NEXT: %vFn8 = load ptr, ptr %vFnPtr7, align 8
  // CHECK-NEXT: call void %vFn8(ptr %obj4, ptr null)
}
