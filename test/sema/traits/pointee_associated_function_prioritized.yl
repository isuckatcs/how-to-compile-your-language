// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A {
  fn foo(self: &Self) {}
}

extension number : A {}

extension *number : A {}

fn main() {
  gc(123).foo();
  // CHECK: DeclRefExpr @({{.*}}) foo {(&number) -> unit}
  // CHECK-NEXT:   ImplicitPtrToRefDecay {&number}
  // CHECK-NEXT:     MaterializeTemporaryExpr {*number}
  // CHECK-NEXT:       GCExpr {*number}
  // CHECK-NEXT:         NumberLiteral '123' {number}
  // CHECK-NEXT:         | value: 123
}
