// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {}

trait B {}

struct S {}

extension S : A {}

fn foo(): *any A {
  // CHECK: [[# @LINE + 1 ]]:10: error: cannot unify '*mut S' with '*any A'
  return gc mut S{};
}

fn bar(): *any B {
  // CHECK: [[# @LINE + 1 ]]:10: error: cannot satisfy requirement 'S : B'
  return gc S{};
}

fn main() {}