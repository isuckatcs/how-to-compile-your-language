// RUN: compiler %s 2>&1 -ast-dump | filecheck %s
struct S {
  x: number,
  y: number,
}
// CHECK: StructDecl 'S'
// CHECK-NEXT:   FieldDecl 'x'
// CHECK-NEXT:     BuiltinType 'number'
// CHECK-NEXT:   FieldDecl 'y'
// CHECK-NEXT:     BuiltinType 'number'

fn main() {}
// CHECK-NEXT: FunctionDecl 'main'
// CHECK-NEXT:   Block

extension S {
  fn foo(self: Self): Self {}

  fn bar() {}

  fn baz(x: number, y: number) {}
}
// CHECK-NEXT: TypeExtension
// CHECK-NEXT:   UserDefinedType 'S'
// CHECK-NEXT:   FunctionDecl 'foo'
// CHECK-NEXT:     BuiltinType 'Self'
// CHECK-NEXT:     ParamDecl 'self'
// CHECK-NEXT:       ArgumentType
// CHECK-NEXT:         BuiltinType 'Self'
// CHECK-NEXT:     Block
// CHECK-NEXT:   FunctionDecl 'bar'
// CHECK-NEXT:     Block
// CHECK-NEXT:   FunctionDecl 'baz'
// CHECK-NEXT:     ParamDecl 'x'
// CHECK-NEXT:       ArgumentType
// CHECK-NEXT:         BuiltinType 'number'
// CHECK-NEXT:     ParamDecl 'y'
// CHECK-NEXT:       ArgumentType
// CHECK-NEXT:         BuiltinType 'number'
// CHECK-NEXT:     Block
