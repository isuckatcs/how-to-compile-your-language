// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A<T> {}

struct Dummy<T> {}

struct S {}

extension S : A<unit> {}
extension S : A<number> {}
extension S : A<Dummy<number>> {}

fn foo<T, U: A<T>>(t: T, u: U) {}

fn main() {
  foo(Dummy@<unit>{}, S{});
  // CHECK: [[# @LINE - 1 ]]:24: error: cannot satisfy requirement 'S : A<Dummy<unit>>'
}
