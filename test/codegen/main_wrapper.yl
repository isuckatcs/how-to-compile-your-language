// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
fn main(): unit {}
// CHECK: define void @_Y4main(ptr %closure) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   ret void
// CHECK-NEXT: }

// CHECK: define i32 @main() {
// CHECK-NEXT: entry:
// CHECK-NEXT:   call void @_Y4main(ptr null)
// CHECK-NEXT:   call void @_Y9gcCollect(ptr null)
// CHECK-NEXT:   ret i32 0
// CHECK-NEXT: }
