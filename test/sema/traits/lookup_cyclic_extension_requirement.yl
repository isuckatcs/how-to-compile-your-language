// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A<T> {}

trait B {
  fn foo(self: &Self) {}
}

extension<T : B> T : A<number> {}
extension<T : A<number>> T : B {}

fn foo<T : B>(t: T) {}

fn main() {
  // CHECK: [[# @LINE + 1 ]]:7: error: overflow while solving 'number : A<number>'
  123.foo();

  // CHECK: [[# @LINE + 1 ]]:7: error: overflow while solving 'number : B'
  foo(123);
}
