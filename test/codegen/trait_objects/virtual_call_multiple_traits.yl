// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '369\n789\n246\n456\n'

// CHECK: @vtable.T1AGS1SE = internal constant [2 x ptr] [ptr @_YT1BGS1SE3bar, ptr @_YT1AGS1SE3foo]
// CHECK: @vtable.T1AGS2S2E = internal constant [2 x ptr] [ptr @_YT1BGS2S2E3bar, ptr @_YT1AGS2S2E3foo]

trait A : B {
  fn foo(self: borrowed Self, x: number) {}
}

trait B {
  fn bar(self: borrowed Self) {
    println(789);
  }
}

struct S {
  n: number
}

extension S : A {
  fn foo(self: borrowed Self, x: number) {
    println(self.n * x);
  }
}

extension S : B {}

struct S2 {}

extension S2 : A {
  fn foo(self: borrowed Self, x: number) {
    println(2 * x);
  }
}

extension S2 : B {
  fn bar(self: borrowed Self) {
    println(456);
  }
}

fn vcall(traitObject: *any A) {
  traitObject.foo(123);
  // CHECK: %objPtr = getelementptr inbounds nuw { ptr, ptr }, ptr %decay, i32 0, i32 0
  // CHECK-NEXT: %obj = load ptr, ptr %objPtr, align 8
  // CHECK-NEXT: %vtablePtr = getelementptr inbounds nuw { ptr, ptr }, ptr %decay, i32 0, i32 1
  // CHECK-NEXT: %vtable = load ptr, ptr %vtablePtr, align 8
  // CHECK-NEXT: %vFnPtr = getelementptr ptr, ptr %vtable, i32 1
  // CHECK-NEXT: %vFn = load ptr, ptr %vFnPtr, align 8
  // CHECK-NEXT: call void %vFn(ptr %obj, double 1.230000e+02, ptr null)
    
  @<any A : B>::bar(traitObject);
  // CHECK: %objPtr2 = getelementptr inbounds nuw { ptr, ptr }, ptr %decay1, i32 0, i32 0
  // CHECK-NEXT: %obj3 = load ptr, ptr %objPtr2, align 8
  // CHECK-NEXT: %vtablePtr4 = getelementptr inbounds nuw { ptr, ptr }, ptr %decay1, i32 0, i32 1
  // CHECK-NEXT: %vtable5 = load ptr, ptr %vtablePtr4, align 8
  // CHECK-NEXT: %vFnPtr6 = getelementptr ptr, ptr %vtable5, i32 0
  // CHECK-NEXT: %vFn7 = load ptr, ptr %vFnPtr6, align 8
  // CHECK-NEXT: call void %vFn7(ptr %obj3, ptr null)
}

fn main() {
  vcall(gc(S { n: 3 }));
  vcall(gc(S2 {}));
}
