// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n246\n'
fn foo(x: &number) {
  println(x);
}

fn bar(y: number) {
  // CHECK: %y1 = alloca double, align 8
  // CHECK-NEXT: store double %y, ptr %y1, align 8

  foo(y);
  // CHECK-NEXT: call void @foo(ptr %y1, ptr null)

  println(y * 2);
  // CHECK-NEXT: %0 = load double, ptr %y1, align 8
  // CHECK-NEXT: %1 = fmul double %0, 2.000000e+00
  // CHECK-NEXT: call void @println(double %1, ptr null)
}

fn main() {
  bar(123);
}
