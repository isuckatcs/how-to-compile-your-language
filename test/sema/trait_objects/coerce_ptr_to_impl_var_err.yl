// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {}

trait B : A {}

trait C {}

struct S {}

extension S : A {}

fn foo(a: *any A, b: *any B) {
  // CHECK: [[# @LINE + 1 ]]:19: error: cannot unify '*any B' with '*any C'
  let x: *any C = b;
  
  // CHECK: [[# @LINE + 1 ]]:19: error: cannot unify '*any A' with '*any B'
  let y: *any B = a;
}

fn main() {}
