// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n456\n'
trait A {
  fn foo(self: borrowed Self) {
    println(123);
  }
}

struct S {
  impl A;
}

struct S2 {
  impl A {
    fn foo(self: borrowed Self) {
      println(456);
    }
  }
}

// CHECK: @vtable.S.A = internal constant [1 x ptr] [ptr @_YT1A3fooGS1SE]
// CHECK: @vtable.S2.A = internal constant [1 x ptr] [ptr @_YT1A3fooGS2S2E]

fn main() {
  mut p: *impl A = gc(S {});
  p.foo();

  p = gc(S2 {});
  p.foo();
}
// CHECK: define void @_YT1A3fooGS1SE(ptr %self, ptr %closure) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   call void @println(double 1.230000e+02, ptr null)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }

// CHECK: define void @_YT1A3fooGS2S2E(ptr %self, ptr %closure) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   call void @println(double 4.560000e+02, ptr null)
// CHECK-NEXT:   ret void
// CHECK-NEXT: }
