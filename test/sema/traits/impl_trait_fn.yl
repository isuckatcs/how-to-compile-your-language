// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A {
  fn foo();
  // CHECK: FunctionDecl @({{.*}}) foo [incomplete] {() -> unit}
}

struct S {}

extension S : A {
  fn foo() {}
  // CHECK: FunctionDecl @({{.*}}) foo {() -> unit}
  // CHECK-NEXT: | implements 'foo' @({{.*}})
  // CHECK-NEXT:   Block
}

fn main() {
  S::foo();
}
// CHECK: FunctionDecl @({{.*}}) main {() -> unit}
// CHECK-NEXT:   Block
// CHECK-NEXT:     CallExpr {unit}
// CHECK-NEXT:       DeclRefExpr @({{.*}}) foo {() -> unit}
