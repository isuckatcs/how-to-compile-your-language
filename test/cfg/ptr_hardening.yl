// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
fn main() {
  let mn = gc mut 123;
  let n: *number = mn;
}

// CHECK: fn main({{.*}}) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   $1 = 123
// CHECK-NEXT:   $2 = gc mut $1
// CHECK-NEXT:   let mn = $2
// CHECK-NEXT:   $3 = mn
// CHECK-NEXT:   $4 = (* <- *mut) $3
// CHECK-NEXT:   let n = $4
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }
