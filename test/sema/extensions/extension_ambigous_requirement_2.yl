// RUN: compiler %s -res-dump 2>&1 | filecheck %s
struct S2 { b: bool }

trait A<T, U> {
  fn foo(self: &Self) {}
}

trait B<T> {
  fn bar(self: &Self) {}
}

extension<T> S2 : A<bool, T> {}

extension<T, U : A<T, T>> U : B<T> {}

extension<T, U : B<T>> U : A<S2, T> {}

fn main() {
  // CHECK: [[# @LINE + 1 ]]:18: error: ambiguous associated function reference
  S2 { b: true }.foo();
}
