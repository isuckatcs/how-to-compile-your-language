// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A {
  fn foo() {}
  fn bar();
}

fn main() {
  // CHECK: [[# @LINE + 1]]:6: error: cannot look up member in trait without a specific extension
  A::foo();

  // CHECK: [[# @LINE + 1]]:6: error: cannot look up member in trait without a specific extension
  A::bar();
}
