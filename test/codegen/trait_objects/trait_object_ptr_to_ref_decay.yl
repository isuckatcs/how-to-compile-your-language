// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '123\n'
trait A {
  fn foo(self: borrowed Self) {
    println(123);
  }
}

struct S {
  impl A;
}

fn main() {
  let s: *impl A = gc(S {});

  // CHECK: %decay = alloca { ptr, ptr }, align 8

  s.foo();
  // CHECK: call void @llvm.memcpy.p0.p0.i64(ptr align 8 %decay, ptr align 8 %s, i64 16, i1 false)
  // CHECK-NEXT: %3 = getelementptr inbounds nuw { ptr, ptr }, ptr %decay, i32 0, i32 0
  // CHECK-NEXT: %4 = load ptr, ptr %3, align 8
  // CHECK-NEXT: store ptr %4, ptr %3, align 8
  
  // CHECK-NEXT: %objPtr = getelementptr inbounds nuw { ptr, ptr }, ptr %decay, i32 0, i32 0
  // CHECK-NEXT: %obj = load ptr, ptr %objPtr, align 8
  // CHECK-NEXT: %vtablePtr = getelementptr inbounds nuw { ptr, ptr }, ptr %decay, i32 0, i32 1
  // CHECK-NEXT: %vtable = load ptr, ptr %vtablePtr, align 8
  // CHECK-NEXT: %vFnPtr = getelementptr ptr, ptr %vtable, i32 0
  // CHECK-NEXT: %vFn = load ptr, ptr %vFnPtr, align 8
  // CHECK-NEXT: call void %vFn(ptr %obj, ptr null)
}
