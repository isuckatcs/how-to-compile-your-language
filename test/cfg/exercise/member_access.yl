// RUN: compiler %s -cfg-dump 2>&1 | filecheck %s --match-full-lines
struct S {
  x: number,
  s2: S2
}

struct S2 {
  y: number
}

fn main(): unit {
  let s = S { x: 0, s2: S2 { y : 1 } };

  let n = s.s2.y;
}
// CHECK: fn main(...) {
// CHECK-NEXT: bb2:
// CHECK-NEXT:   preds: 
// CHECK-NEXT:   succs: 1 
// CHECK-NEXT: 
// CHECK-NEXT: bb1:
// CHECK-NEXT:   preds: 2 
// CHECK-NEXT:   $1 = 0
// CHECK-NEXT:   $2 = 1
// CHECK-NEXT:   $3 = S2 { y: $2 }
// CHECK-NEXT:   $4 = S { x: $1, s2: $3 }
// CHECK-NEXT:   let s = $4
// CHECK-NEXT:   $5 = s
// CHECK-NEXT:   let n = $5.s2.y
// CHECK-NEXT:   succs: 0 
// CHECK-NEXT: 
// CHECK-NEXT: bb0:
// CHECK-NEXT:   preds: 1 
// CHECK-NEXT:   succs: 
// CHECK-NEXT: }
