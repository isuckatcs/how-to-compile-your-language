// RUN: compiler %s 2>&1 -res-dump | filecheck %s
fn foo<T>() {}

struct S<T> {}

extension<T> S<T> {
  fn foo<U>() {
    foo@<T>();
  }
}

fn main() {
  S@<number>::foo@<unit>();
}
// CHECK: FunctionDecl @({{.*}}) main {() -> unit}
// CHECK-NEXT:   Block
// CHECK-NEXT:     CallExpr {unit}
// CHECK-NEXT:       DeclRefExpr @({{.*}}) foo {() -> unit}
