// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '1\n'
fn foo(b: bool): number {
  let cond = b;

  if cond && cond {
  // CHECK: %1 = load i8, ptr %cond, align 1
  // CHECK-NEXT: %2 = trunc i8 %1 to i1
  // CHECK-NEXT: br i1 %2, label %and.rhs, label %and.merge

    return 1;
  }

  return 0;
}

fn main() {
  println(foo(true));
}
