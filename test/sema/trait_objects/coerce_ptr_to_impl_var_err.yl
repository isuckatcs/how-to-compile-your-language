// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {}

trait B : A {}

trait C {}

struct S {
  impl A;
}

fn foo(a: *any A, b: *any B) {
  // CHECK: [[# @LINE + 1 ]]:19: error: an expression of type '*any B' cannot be used to initialize a variable of type '*any C'
  let x: *any C = b;
  
  // CHECK: [[# @LINE + 1 ]]:19: error: an expression of type '*any A' cannot be used to initialize a variable of type '*any B'
  let y: *any B = a;
}

fn main() {}
