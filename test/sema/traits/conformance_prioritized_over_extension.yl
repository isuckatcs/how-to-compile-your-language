// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A<T> {
  fn foo(self: borrowed Self) {
    println(123);
  }
}

trait B : A<number> {}

extension<T> T : A<unit> {}

fn foo<T : B>(t: T) {
  bar(t);
  // CHECK: DeclRefExpr @({{.*}}) bar {(T) -> unit}
  
  bar@<unit, T>(t);
  // CHECK: DeclRefExpr @({{.*}}) bar {(T) -> unit}
}

fn bar<T, U: A<T>>(u: U) {}

fn main() {}
