// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzxe '0\n1\n2\n3\n4\n5\n'
struct S {
  x: unit,
  y: (number, number) -> S2,
  z: unit
}

struct S2 {
  x: unit,
  y: unit
}

fn foo(x: number, y: number): S2 {
  return S2 { x: println(x), y: println(y) };
}
// CHECK: define void @_Y3foo(double %x, double %y, ptr %closure) {
// CHECK-NEXT: entry:
// CHECK-NEXT:   call void @_Y7println(double %x, ptr null)
// CHECK-NEXT:   call void @_Y7println(double %y, ptr null)
// CHECK-NEXT:   br label %return
// CHECK-NEXT: 
// CHECK-NEXT: return:                                           ; preds = %entry
// CHECK-NEXT:   ret void
// CHECK-NEXT: }

fn main() {
// CHECK: define void @_Y4main(ptr %closure) gc "shadow-stack" {
  // CHECK-NEXT: entry:
  // CHECK-NEXT:   %S.tmp = alloca { { ptr, ptr } }, align 8
  // CHECK-NEXT:   %s = alloca { { ptr, ptr } }, align 8
  // CHECK-NEXT:   %0 = alloca [0 x i8], align 1
  // CHECK-NEXT:   %1 = alloca [0 x i8], align 1
  // CHECK-NEXT:   store { { ptr, ptr } } zeroinitializer, ptr %s, align 8
  // CHECK-NEXT:   call void @llvm.gcroot(ptr %s, ptr @S1S.offsets)

  let s = S { 
    x: println(0), 
    y: foo, 
    z: println(1) 
  };
  // CHECK-NEXT:   call void @_Y7println(double 0.000000e+00, ptr null)
  // CHECK-NEXT:   call void @_Y7println(double 1.000000e+00, ptr null)
  // CHECK-NEXT:   %2 = getelementptr inbounds nuw { { ptr, ptr } }, ptr %S.tmp, i32 0, i32 0
  // CHECK-NEXT:   %3 = getelementptr inbounds nuw { ptr, ptr }, ptr %2, i32 0, i32 0
  // CHECK-NEXT:   store ptr @_Y3foo, ptr %3, align 8
  // CHECK-NEXT:   %4 = getelementptr inbounds nuw { ptr, ptr }, ptr %2, i32 0, i32 1
  // CHECK-NEXT:   store ptr null, ptr %4, align 8
  // CHECK-NEXT:   call void @llvm.memcpy.p0.p0.i64(ptr align 8 %s, ptr align 8 %S.tmp, i64 16, i1 false)

  let x = s.x;
  // CHECK-NEXT:   %5 = getelementptr { { ptr, ptr } }, ptr %s, i64 1

  let y = (s.y)(2, 3).x;
  // CHECK-NEXT:   %6 = getelementptr inbounds nuw { { ptr, ptr } }, ptr %s, i32 0, i32 0
  // CHECK-NEXT:   %7 = getelementptr inbounds nuw { ptr, ptr }, ptr %6, i32 0, i32 0
  // CHECK-NEXT:   %8 = load ptr, ptr %7, align 8
  // CHECK-NEXT:   %9 = getelementptr inbounds nuw { ptr, ptr }, ptr %6, i32 0, i32 1
  // CHECK-NEXT:   %10 = load ptr, ptr %9, align 8
  // CHECK-NEXT:   call void %8(double 2.000000e+00, double 3.000000e+00, ptr %10)

  let z = (s.y)(4, 5).y;
  // CHECK-NEXT:   %11 = getelementptr inbounds nuw { { ptr, ptr } }, ptr %s, i32 0, i32 0
  // CHECK-NEXT:   %12 = getelementptr inbounds nuw { ptr, ptr }, ptr %11, i32 0, i32 0
  // CHECK-NEXT:   %13 = load ptr, ptr %12, align 8
  // CHECK-NEXT:   %14 = getelementptr inbounds nuw { ptr, ptr }, ptr %11, i32 0, i32 1
  // CHECK-NEXT:   %15 = load ptr, ptr %14, align 8
  // CHECK-NEXT:   call void %13(double 4.000000e+00, double 5.000000e+00, ptr %15)

  let w = s.z;
  // CHECK-NEXT:   %16 = getelementptr { { ptr, ptr } }, ptr %s, i64 1

  // CHECK-NEXT:   ret void
  // CHECK-NEXT: }
}
