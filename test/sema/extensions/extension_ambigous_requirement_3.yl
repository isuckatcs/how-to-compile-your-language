// RUN: compiler %s -res-dump 2>&1 | filecheck %s
struct S<T> {}

trait A<T> {}

trait B<T> {
  fn foo(self: &Self) {}
}

extension<T> S<T> : A<bool> {}

extension<T> S<T> : A<number> {}

extension<T, U : A<T>> U : B<T> {}

fn foo<T>(t: T): T {
  return t;
}

fn main() {
  let s = S{};

  s.foo();
  // CHECK: [[# @LINE - 1 ]]:5: error: 'A<bool>' ambiguously satisfies requirement 'S<_> : A<_>'
  // CHECK: [[# @LINE - 2 ]]:5: error: 'A<number>' ambiguously satisfies requirement 'S<_> : A<_>'
  // CHECK: [[# @LINE - 3 ]]:5: error: explicit type annotations needed to disambiguate requirements

  S::foo();
  // CHECK: [[# @LINE - 1 ]]:6: error: 'A<bool>' ambiguously satisfies requirement 'S<_> : A<_>'
  // CHECK: [[# @LINE - 2 ]]:6: error: 'A<number>' ambiguously satisfies requirement 'S<_> : A<_>'
  // CHECK: [[# @LINE - 3 ]]:6: error: explicit type annotations needed to disambiguate requirements
}
