// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A {
  fn foo() {}
}
// CHECK: TraitDecl @({{.*}}) A
// CHECK-NEXT:   TypeParamDecl @({{.*}}) Self {Self}
// CHECK-NEXT:   FunctionDecl @({{.*}}) foo {() -> unit}
// CHECK-NEXT:     Block

struct S {}

extension S : A {}

fn main() {
  S::foo();
}
// CHECK: FunctionDecl @({{.*}}) main {() -> unit}
// CHECK-NEXT:   Block
// CHECK-NEXT:     CallExpr {unit}
// CHECK-NEXT:       DeclRefExpr @({{.*}}) foo {() -> unit}
