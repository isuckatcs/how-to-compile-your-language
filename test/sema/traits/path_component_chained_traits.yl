// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait B {}

trait A<T> {
  fn foo(self: &Self) {}
}

struct S {}

extension S : A<number> {
  fn foo(self: &Self) {}
}

extension S : A<unit> {
  fn foo(self: &Self) {}
}

fn main() {
  let s = S{};

  // CHECK: [[# @LINE + 1]]:21: error: failed to find member 'B' in 'A<number>'
  @<S : A<number>>::B;
}
