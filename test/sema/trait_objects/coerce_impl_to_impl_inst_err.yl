// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {}

trait B : A {}

trait C {}

struct S {
  x: *any C,
  y: *any B
}

fn foo(x: *any B, y: *any A) {
  S { 
    // CHECK: [[# @LINE + 1 ]]:8: error: cannot unify '*any B' with '*any C'
    x: x,
    
    // CHECK: [[# @LINE + 1 ]]:8: error: cannot unify '*any A' with '*any B'
    y: y,
  };
}

fn main() {}
