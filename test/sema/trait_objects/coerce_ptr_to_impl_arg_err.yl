// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A {}

trait B {}

struct S {}

extension S : A {}

fn foo(x: *any A) {}
fn bar(x: *any B) {}

fn main() {
  // CHECK: [[# @LINE + 1 ]]:7: error: cannot unify '*mut S' with '*any A'
  foo(gc mut S{});

  // CHECK: [[# @LINE + 1 ]]:7: error: cannot satisfy requirement 'S : B'
  bar(gc S{});
}
