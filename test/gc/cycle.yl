// RUN: compiler %s -o %t && YL_GC_DUMP=1 %t | filecheck %s
// RUN: %valgrind %t
struct Node<T> {
  val: T,
  next: *mut Node<T>,
}

fn createCycle(): *mut Node<number> {
  let n3 = gc mut Node { val: 3, next: nullMut() };
  let n2 = gc mut Node { val: 2, next: n3 };
  let n1 = gc mut Node { val: 1, next: n2 };

  n3.next = n1;
  return n1;
}

fn main() {
  mut cycle = createCycle();

  println(cycle.val);
  // CHECK: {{^1$}}

  println(cycle.next.val);
  // CHECK-NEXT: {{^2$}}

  println(cycle.next.next.val);
  // CHECK-NEXT: {{^3$}}

  println(cycle.next.next.next.val);
  // CHECK-NEXT: {{^1$}}

  gcCollect();
  // CHECK-NEXT: [1] mark {{.*}} data: {{.*}} (16 B) offsets: {8 {{.*}}} {heap: 120 B, threshold: 240 B}
  // CHECK-NEXT: [1] mark {{.*}} data: {{.*}} (16 B) offsets: {8 {{.*}}} {heap: 120 B, threshold: 240 B}
  // CHECK-NEXT: [1] mark {{.*}} data: {{.*}} (16 B) offsets: {8 {{.*}}} {heap: 120 B, threshold: 240 B}
  // CHECK-NEXT: [1] sweep {heap: 120 B, threshold: 240 B}

  cycle = nullMut();

  gcCollect();
  // CHECK-NEXT: [2] sweep {{.*}} data: {{.*}} (16 B) offsets: {8 {{.*}}} {heap: 80 B, threshold: 240 B}
  // CHECK-NEXT: [2] sweep {{.*}} data: {{.*}} (16 B) offsets: {8 {{.*}}} {heap: 40 B, threshold: 240 B}
  // CHECK-NEXT: [2] sweep {{.*}} data: {{.*}} (16 B) offsets: {8 {{.*}}} {heap: 0 B, threshold: 240 B}
  // CHECK-NEXT: [2] sweep {heap: 0 B, threshold: 96 B}
}
