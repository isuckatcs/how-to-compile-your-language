// RUN: compiler %s -verify-only
// RUN: compiler %s -llvm-dump 2>&1 | filecheck %s
// RUN: compiler %s -o %t && %t | grep -Plzx '456\n'

// CHECK: @vtable.T1BGS1SnE = internal constant [2 x ptr] [ptr @_YT1AGS1SuE3foo, ptr @_YT1AGS1SnE3foo]

trait A<T> {
  fn foo(self: &Self) {
    println(123);
  }
}

trait B<T> : A<unit> & A<number> {}

struct S {}

extension<T> S : B<T> {}

extension S : A<unit> {}

extension S : A<number> {
  fn foo(self: &Self) {
    println(456);
  }
}

fn foo<U>() {
  let s: *any B<U> = gc(S {});

  @<any B<U> : A<number>>::foo(s);
  // CHECK: %vtablePtr = getelementptr inbounds nuw { ptr, ptr }, ptr %decay, i32 0, i32 1
  // CHECK-NEXT: %vtable = load ptr, ptr %vtablePtr, align 8
  // CHECK-NEXT: %vFnPtr = getelementptr ptr, ptr %vtable, i32 1
  // CHECK-NEXT: %vFn = load ptr, ptr %vFnPtr, align 8
  // CHECK-NEXT: call void %vFn(ptr %obj, ptr null)
}

fn main() {
  foo@<number>();
}
