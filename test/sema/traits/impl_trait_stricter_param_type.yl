// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait B<T> {}

trait A {
  fn foo<T, U : B<T>>();
}

struct S {}

extension S : A {
  fn foo<X, Y : B<X> & B<unit>>() {}
  // CHECK: [[# @LINE - 1]]:13: error: cannot replace parameter of type 'U' with stricter implementation type 'Y'
}

fn main() {}
// CHECK-NOT: FunctionDecl @({{.*}}) main {() -> unit}
