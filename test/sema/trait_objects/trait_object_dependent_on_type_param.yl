// RUN: compiler %s 2>&1 -res-dump | filecheck %s
trait A<T> {
  fn foo(self: borrowed Self, t: T) {}
}

struct S<T> {}

extension<T> S<T> : A<T> {}

fn foo<T>(x: *any A<T>) {}

fn main() {
  foo(gc(S@<unit>{}));
  // CHECK: CallExpr {unit}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) foo {(*any A<unit>) -> unit}
  // CHECK-NEXT:   TraitObjectPromoExpr {*any A<unit>}

  foo(gc(S@<number>{}));
  // CHECK: CallExpr {unit}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) foo {(*any A<number>) -> unit}
  // CHECK-NEXT:   TraitObjectPromoExpr {*any A<number>}

  foo(gc(S@<() -> unit>{}));
  // CHECK: CallExpr {unit}
  // CHECK-NEXT:   DeclRefExpr @({{.*}}) foo {(*any A<() -> unit>) -> unit}
  // CHECK-NEXT:   TraitObjectPromoExpr {*any A<() -> unit>}
}
