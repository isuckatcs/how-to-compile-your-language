// RUN: compiler %s -res-dump 2>&1 | filecheck %s
trait A {
  fn foo() {}
}

struct S {}

extension S : A {
  fn foo() {}

  // CHECK: [[# @LINE + 1 ]]:6: error: function 'foo' is already implemented for trait 'A'
  fn foo() {}
}

// CHECK: [[# @LINE + 1 ]]:15: error: implementing trait 'A' conflicts with implementation 'A'
extension S : A {
  fn foo() {}
}

fn main() {}
